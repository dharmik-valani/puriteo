    "as_faq_homepage": {
      "type": "homepage-faq",
      "blocks": {
        "faq_safety": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>Are Puriteo products safe and lab-tested?</p>",
            "peracontent": "<p>Yes. Puriteo products are formulated with science-backed ingredients and manufactured in facilities that follow strict quality and safety standards, including certified manufacturing practices.</p>"
          }
        },
        "faq_usage": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>How should I take Puriteo supplements?</p>",
            "peracontent": "<p>Follow the usage directions on each product label. Mix powders with water as directed, or dissolve effervescent tablets fully before drinking. For best results, take them consistently as part of your daily routine.</p>"
          }
        },
        "faq_shipping": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>Do you ship across India, and how long does delivery take?</p>",
            "peracontent": "<p>Yes, we ship across India. Orders are typically processed quickly, and delivery usually takes a few business days depending on your location and courier timelines.</p>"
          }
        },
        "faq_returns": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>What is your return and refund policy?</p>",
            "peracontent": "<p>If your order arrives damaged or incorrect, contact our support team with your order details and photos. Eligible returns or replacements are handled as per our return policy shared at checkout and on our policy pages.</p>"
          }
        },
        "faq_fitness": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>Are Puriteo products suitable for daily fitness and wellness goals?</p>",
            "peracontent": "<p>Absolutely. From protein and amino acids to everyday wellness essentials, our range is designed to support energy, recovery, immunity, and overall well-being when used as directed.</p>"
          }
        },
        "faq_combine": {
          "type": "Add-FAQ",
          "settings": {
            "title": "<p>Can I take more than one Puriteo product together?</p>",
            "peracontent": "<p>Many customers combine products based on their goals. Always check label directions and consult a healthcare professional if you have a medical condition, are pregnant, or take prescription medication.</p>"
          }
        }
      },
      "block_order": [
