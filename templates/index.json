    "testimonial_slider_FNf34T": {
      "type": "testimonial-slider",
      "blocks": {
        "review_RGtJpH": {
          "type": "review",
          "settings": {
            "review_title": "Helps Control Cravings and Boost Energy!",
            "review_text": "I’ve always struggled with controlling my weight and managing cravings, despite trying different diets and workouts. Staying consistent was tough, and I often felt low on energy. Then I started using these effervescent weight management tablets, and they’ve made a noticeable difference. They taste refreshing, help curb my cravings, and keep my energy levels steady throughout the day. It’s a simple addition that really supports a healthier, balanced lifestyle. Best product for weight management.",
            "client_name": "Janki",
            "rating": 5
          }
        },
        "review_YQdbJB": {
          "type": "review",
          "settings": {
            "review_title": "Boosted My Energy and Immunity!",
            "review_text": "I was constantly feeling low on energy and worried about my weakening immunity. Then I found puriteo on social media, it felt trusted. I’ve been using these effervescent tablets for a few weeks, and they’ve really boosted my energy and immunity. They dissolve quickly, taste great, and make it easy to stay consistent with my health routine. I feel less tired and more active throughout the day. It’s a simple habit that’s made a noticeable difference in how strong and fresh I feel. This is the best product i have used till now.",
            "client_name": "Ankit",
            "rating": 5
          }
        },
        "review_7qVfxm": {
          "type": "review",
          "settings": {
            "review_title": "A Game-Changer for My Hair Growth!",
            "review_text": "Hair fall and slow hair growth had really started affecting my confidence. I tried several oils and remedies, but nothing seemed to work consistently. Then a friend recommended puriteo hair growth tablets. I started using these tablets, and within a few weeks, I noticed less hair fall and stronger strands. My hair feels thicker, healthier, and has regained its natural shine. It’s honestly been a game-changer for my hair care routine. Works best.",
            "client_name": "Neha",
            "rating": 5
          }
        }
      },
      "block_order": [
        "review_RGtJpH",
        "review_YQdbJB",
        "review_7qVfxm"
      ],
