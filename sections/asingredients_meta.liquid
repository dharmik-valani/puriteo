{%- liquid
  assign has_item1 = false
  assign has_item2 = false
  assign has_item3 = false
  assign has_item4 = false

  # Metaobject support
  assign meta_list = product.metafields.custom.key_ingredients.value
  if meta_list == blank
    assign meta_list = product.metafields.custom.key_ingredients
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom.key_ingredient.value
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom.key_ingredient
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom.ingredients.value
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom.ingredients
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom['key-ingredients'].value
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom['key-ingredients']
  endif
  if meta_list == blank
    assign meta_list = product.metafields.custom['key_ingredients'].value
  endif

  if meta_list != blank and meta_list.size > 0
    for item in meta_list limit: 4
      assign i_idx = forloop.index
      assign m_title = item.title.value | default: item.title | default: item.name.value | default: item.name | default: item.label.value | default: item.label | default: item.heading.value | default: item.heading | default: item.ingredient_name.value | default: item.ingredient_name | default: item.display_name.value | default: item.display_name
      assign m_desc = item.description.value | default: item.description | default: item.desc.value | default: item.desc | default: item.pera.value | default: item.pera | default: item.benefit.value | default: item.benefit | default: item.details.value | default: item.details | default: item.text.value | default: item.text
      assign m_image = item.image.value | default: item.image | default: item.icon.value | default: item.icon | default: item.img.value | default: item.img | default: item.photo.value | default: item.photo | default: item.ingredient_image.value | default: item.ingredient_image

      if m_image.value != blank
        assign m_image = m_image.value
      endif

      if m_title == blank or m_desc == blank or m_image == blank
        if item.fields != blank
          for f in item.fields
            assign f_key = f.key | downcase
            assign f_val = f.value | default: f
            if m_image == blank
              if f.type contains 'file' or f_key contains 'image' or f_key contains 'img' or f_key contains 'icon' or f_key contains 'photo'
                if f_val != blank
                  assign m_image = f_val
                endif
              endif
            endif
            if m_title == blank
              if f_key contains 'title' or f_key contains 'name' or f_key contains 'label' or f_key contains 'heading'
                assign m_title = f_val | strip_html | strip
              endif
            endif
            if m_desc == blank
              if f_key contains 'desc' or f_key contains 'pera' or f_key contains 'benefit' or f_key contains 'detail' or f_key contains 'text'
                assign m_desc = f_val | strip_html | strip
              endif
            endif
          endfor
        endif
      endif

      if m_title == blank and item.system.handle != blank
        assign m_title = item.system.handle | replace: '-', ' ' | capitalize
      endif

      if i_idx == 1
        assign t1 = m_title | strip_html | strip
        assign p1 = m_desc | strip_html | strip
        assign img1 = m_image
        if t1 != blank or p1 != blank or img1 != blank
          assign has_item1 = true
        endif
      elsif i_idx == 2
        assign t2 = m_title | strip_html | strip
        assign p2 = m_desc | strip_html | strip
        assign img2 = m_image
        if t2 != blank or p2 != blank or img2 != blank
          assign has_item2 = true
        endif
      elsif i_idx == 3
        assign t3 = m_title | strip_html | strip
        assign p3 = m_desc | strip_html | strip
        assign img3 = m_image
        if t3 != blank or p3 != blank or img3 != blank
          assign has_item3 = true
        endif
      elsif i_idx == 4
        assign t4 = m_title | strip_html | strip
        assign p4 = m_desc | strip_html | strip
        assign img4 = m_image
        if t4 != blank or p4 != blank or img4 != blank
          assign has_item4 = true
        endif
      endif
    endfor
  elsif template.suffix != 'new-product-page'
    assign t1 = product.metafields.custom.ingredients_title01.value | default: product.metafields.custom.ingredients_title01 | default: section.settings.title_ingredients01 | strip_html | strip
    assign p1 = product.metafields.custom.ingredients_pera01.value | default: product.metafields.custom.ingredients_pera01 | default: section.settings.pera_ingredients01 | strip_html | strip
    assign img1 = product.metafields.custom.ingredients_img_01.value | default: product.metafields.custom.ingredients_img_01 | default: section.settings.image_ingredients01

    if img1 != blank or t1 != blank or p1 != blank
      assign has_item1 = true
    endif

    assign t2 = product.metafields.custom.ingredients_title02.value | default: product.metafields.custom.ingredients_title02 | default: section.settings.title_ingredients02 | strip_html | strip
    assign p2 = product.metafields.custom.ingredients_pera02.value | default: product.metafields.custom.ingredients_pera02 | default: section.settings.pera_ingredients02 | strip_html | strip
    assign img2 = product.metafields.custom.ingredients_img_02.value | default: product.metafields.custom.ingredients_img_02 | default: section.settings.image_ingredients02

    if img2 != blank or t2 != blank or p2 != blank
      assign has_item2 = true
    endif

    assign t3 = product.metafields.custom.ingredients_title03.value | default: product.metafields.custom.ingredients_title03 | default: section.settings.title_ingredients03 | strip_html | strip
    assign p3 = product.metafields.custom.ingredients_pera03.value | default: product.metafields.custom.ingredients_pera03 | default: section.settings.pera_ingredients03 | strip_html | strip
    assign img3 = product.metafields.custom.ingredients_img_03.value | default: product.metafields.custom.ingredients_img_03 | default: section.settings.image_ingredients03

    if img3 != blank or t3 != blank or p3 != blank
      assign has_item3 = true
    endif

    assign t4 = product.metafields.custom.ingredients_title04.value | default: product.metafields.custom.ingredients_title04 | default: section.settings.title_ingredients04 | strip_html | strip
    assign p4 = product.metafields.custom.ingredients_pera04.value | default: product.metafields.custom.ingredients_pera04 | default: section.settings.pera_ingredients04 | strip_html | strip
    assign img4 = product.metafields.custom.ingredients_img_04.value | default: product.metafields.custom.ingredients_img_04 | default: section.settings.image_ingredients04

    if img4 != blank or t4 != blank or p4 != blank
      assign has_item4 = true
    endif
  else
    assign t1 = section.settings.title_ingredients01 | strip_html | strip
    assign p1 = section.settings.pera_ingredients01 | strip_html | strip
    assign img1 = section.settings.image_ingredients01
    if img1 != blank or t1 != blank or p1 != blank
      assign has_item1 = true
    endif

    assign t2 = section.settings.title_ingredients02 | strip_html | strip
    assign p2 = section.settings.pera_ingredients02 | strip_html | strip
    assign img2 = section.settings.image_ingredients02
    if img2 != blank or t2 != blank or p2 != blank
      assign has_item2 = true
    endif

    assign t3 = section.settings.title_ingredients03 | strip_html | strip
    assign p3 = section.settings.pera_ingredients03 | strip_html | strip
    assign img3 = section.settings.image_ingredients03
    if img3 != blank or t3 != blank or p3 != blank
      assign has_item3 = true
    endif

    assign t4 = section.settings.title_ingredients04 | strip_html | strip
    assign p4 = section.settings.pera_ingredients04 | strip_html | strip
    assign img4 = section.settings.image_ingredients04
    if img4 != blank or t4 != blank or p4 != blank
      assign has_item4 = true
    endif
  endif

  assign has_ingredients = false
  if has_item1 or has_item2 or has_item3 or has_item4
    assign has_ingredients = true
  endif
-%}

