{%- liquid
  assign steps_key = blank
  assign step_count = 0

  if product != blank
    if product.metafields.custom.how_to_use_reference.type contains 'metaobject_reference' or product.metafields.custom.how_to_use_reference.value != blank
      assign steps_key = 'how_to_use_reference'
    elsif product.metafields.custom.how_to_use.type contains 'metaobject_reference'
      assign steps_key = 'how_to_use'
    elsif product.metafields.custom.how_to_use_steps.type contains 'metaobject_reference'
      assign steps_key = 'how_to_use_steps'
    elsif product.metafields.custom.how_to_use_step.type contains 'metaobject_reference'
      assign steps_key = 'how_to_use_step'
    else
      for mf in product.metafields.custom
        if mf.last.type contains 'metaobject_reference'
          assign k = mf.first
          if k contains 'how_to_use' or k contains 'step'
            assign steps_key = k
            break
          endif
        endif
      endfor
    endif

    if steps_key != blank
      for step in product.metafields.custom[steps_key].value
        assign step_count = forloop.length
      endfor
    endif

    if step_count == 0
      for step in product.metafields.custom.how_to_use_reference.value
        if step.system.handle != blank or step.system.type != blank or step.step_title.value != blank or step.system.display_name != blank
          assign steps_key = 'how_to_use_reference'
          assign step_count = forloop.length
          break
        endif
      endfor
    endif

    if step_count == 0
      for step in product.metafields.custom.how_to_use.value
        if step.system.handle != blank or step.system.type != blank or step.step_title.value != blank or step.system.display_name != blank
          assign steps_key = 'how_to_use'
          assign step_count = forloop.length
          break
        endif
      endfor
    endif

    if step_count == 0
      for step in product.metafields.custom.how_to_use_steps.value
        if step.system.handle != blank or step.system.type != blank or step.step_title.value != blank or step.system.display_name != blank
          assign steps_key = 'how_to_use_steps'
          assign step_count = forloop.length
          break
        endif
      endfor
    endif

    assign htu_banner_desktop = blank
    assign htu_banner_mobile = blank

    if product.metafields.custom.how_to_use_image.value != blank
      assign htu_banner_desktop = product.metafields.custom.how_to_use_image.value
    elsif product.metafields.custom.how_to_use_image != blank
      assign htu_banner_desktop = product.metafields.custom.how_to_use_image
    endif

    if product.metafields.custom.how_to_use_mobile_image.value != blank
      assign htu_banner_mobile = product.metafields.custom.how_to_use_mobile_image.value
    elsif product.metafields.custom.how_to_use_mobile_image != blank
      assign htu_banner_mobile = product.metafields.custom.how_to_use_mobile_image
    elsif product.metafields.custom.how_to_use_image_mobile.value != blank
      assign htu_banner_mobile = product.metafields.custom.how_to_use_image_mobile.value
    elsif product.metafields.custom.how_to_use_image_mobile != blank
      assign htu_banner_mobile = product.metafields.custom.how_to_use_image_mobile
    endif

    if htu_banner_desktop == blank and htu_banner_mobile != blank
      assign htu_banner_desktop = htu_banner_mobile
    elsif htu_banner_mobile == blank and htu_banner_desktop != blank
      assign htu_banner_mobile = htu_banner_desktop
    endif
  endif

  assign has_banner = false
  if htu_banner_desktop != blank or htu_banner_mobile != blank
    assign has_banner = true
  endif

  assign show_section = true
  if section.settings.hide_if_empty and step_count == 0 and has_banner == false
    assign show_section = false
  endif

  assign show_banner_heading = section.settings.show_banner_heading
  if show_banner_heading == nil
    assign show_banner_heading = false
  endif

  assign show_heading = false
  if section.settings.show_heading and section.settings.heading != blank
    if step_count > 0
      assign show_heading = true
    elsif has_banner and show_banner_heading
      assign show_heading = true
    endif
  endif

  assign heading_id = 'HowToUseHeading-' | append: section.id
  assign media_class = 'how-to-use__media'
  if section.settings.image_ratio == 'auto'
    assign media_class = media_class | append: ' how-to-use__media--natural'
  endif

  assign single_row_desktop = section.settings.single_row_desktop
  if single_row_desktop == nil
    assign single_row_desktop = true
  endif

  assign single_row_mobile = section.settings.single_row_mobile
  if single_row_mobile == nil
    assign single_row_mobile = true
  endif

  assign dynamic_cols = section.settings.columns_desktop
  assign dynamic_max_width = section.settings.max_width
  assign dynamic_gap = section.settings.card_gap
  assign dynamic_card_pad = section.settings.card_padding
  assign dynamic_title_size = section.settings.title_size
  assign dynamic_text_size = section.settings.instruction_size

  if single_row_desktop
    assign dynamic_cols = step_count | at_most: 6 | at_least: 1
    case dynamic_cols
      when 1
        assign dynamic_max_width = 460
        assign dynamic_gap = 16
        assign dynamic_card_pad = 16
        assign dynamic_title_size = 17
        assign dynamic_text_size = 14
      when 2
        assign dynamic_max_width = 720
        assign dynamic_gap = 20
        assign dynamic_card_pad = 16
        assign dynamic_title_size = 16
        assign dynamic_text_size = 13.5
      when 3
        assign dynamic_max_width = 1040
        assign dynamic_gap = 18
        assign dynamic_card_pad = 16
        assign dynamic_title_size = 15.5
        assign dynamic_text_size = 13
      when 4
        assign dynamic_max_width = 1260
        assign dynamic_gap = 16
        assign dynamic_card_pad = 15
        assign dynamic_title_size = 15
        assign dynamic_text_size = 12.5
      when 5
        assign dynamic_max_width = 1440
        assign dynamic_gap = 14
        assign dynamic_card_pad = 14
        assign dynamic_title_size = 14.5
        assign dynamic_text_size = 12
      else
        assign dynamic_max_width = 1500
        assign dynamic_gap = 12
        assign dynamic_card_pad = 12
        assign dynamic_title_size = 13.5
        assign dynamic_text_size = 11.5
    endcase
  endif
-%}

{%- if show_section -%}
  {% style %}
    #shopify-section-{{ section.id }} .how-to-use {
      --htu-bg: {{ section.settings.background_color }};
      --htu-card-bg: {{ section.settings.card_color }};
      --htu-image-bg: {{ section.settings.image_background }};
      --htu-placeholder-bg: {{ section.settings.placeholder_color }};
      --htu-heading: {{ section.settings.heading_color }};
      --htu-title: {{ section.settings.title_color }};
      --htu-text: {{ section.settings.instruction_color }};
      --htu-badge-bg: {{ section.settings.badge_background }};
      --htu-badge-text: {{ section.settings.badge_color }};
      --htu-border: {{ section.settings.border_color }};
      --htu-border-width: {{ section.settings.border_width }}px;
      --htu-max-width: {{ dynamic_max_width }}px;
      --htu-cols: {{ dynamic_cols }};
      --htu-cols-tablet: {{ section.settings.columns_tablet }};
      --htu-cols-mobile: {{ section.settings.columns_mobile }};
      --htu-gap: {{ dynamic_gap }}px;
      --htu-gap-mobile: {{ section.settings.card_gap_mobile }}px;
      --htu-card-pad: {{ dynamic_card_pad }}px;
      --htu-card-pad-mobile: {{ section.settings.card_padding_mobile }}px;
      --htu-card-radius: {{ section.settings.card_radius }}px;
      --htu-image-radius: {{ section.settings.image_radius }}px;
      --htu-image-width: {{ section.settings.image_width }}%;
      --htu-fit: {{ section.settings.image_fit }};
      --htu-ratio: {{ section.settings.image_ratio }};
      --htu-heading-align: {{ section.settings.heading_alignment }};
      --htu-heading-size: {{ section.settings.heading_size }}px;
      --htu-heading-size-mobile: {{ section.settings.heading_size_mobile }}px;
      --htu-title-size: {{ dynamic_title_size }}px;
      --htu-title-size-mobile: {{ section.settings.title_size_mobile }}px;
      --htu-text-size: {{ dynamic_text_size }}px;
      --htu-text-size-mobile: {{ section.settings.instruction_size_mobile }}px;
      --htu-heading-weight: {{ section.settings.heading_weight }};
      --htu-title-weight: {{ section.settings.title_weight }};
      --htu-text-lh: {{ section.settings.instruction_line_height }};
      --htu-pt: {{ section.settings.padding_top }}px;
      --htu-pr: {{ section.settings.padding_right }}px;
      --htu-pb: {{ section.settings.padding_bottom }}px;
      --htu-pl: {{ section.settings.padding_left }}px;
      --htu-pt-mobile: {{ section.settings.padding_top_mobile }}px;
      --htu-pr-mobile: {{ section.settings.padding_right_mobile }}px;
      --htu-pb-mobile: {{ section.settings.padding_bottom_mobile }}px;
      --htu-pl-mobile: {{ section.settings.padding_left_mobile }}px;
      --htu-heading-gap: {{ section.settings.heading_gap }}px;
      --htu-heading-gap-mobile: {{ section.settings.heading_gap_mobile }}px;
      --htu-image-gap: {{ section.settings.image_gap }}px;
      --htu-image-gap-mobile: {{ section.settings.image_gap_mobile }}px;
      --htu-text-gap: {{ section.settings.text_gap }}px;
      --htu-banner-radius: {{ section.settings.banner_radius | default: 16 }}px;
    }
  {% endstyle %}

  {%- if step_count == 0 and has_banner -%}
    {%- liquid
      assign banner_pt = section.settings.banner_padding_top | default: 0
      assign banner_pb = section.settings.banner_padding_bottom | default: 0
      assign banner_pt_mb = section.settings.banner_padding_top_mobile | default: 0
      assign banner_pb_mb = section.settings.banner_padding_bottom_mobile | default: 0
    -%}
    {%- style -%}
      #shopify-section-{{ section.id }} .how-to-use-banner-slideshow,
      .section-block-{{ section.id }}.how-to-use-banner-slideshow {
        padding-top: {{ banner_pt }}px !important;
        padding-bottom: {{ banner_pb }}px !important;
        margin-top: 0 !important;
        margin-bottom: 0 !important;
      }
      .section-block-{{ section.id }} .slideshow .adaptive_height,
      .section-block-{{ section.id }} .slideshow .adaptive_height img {
        border-radius: {{ section.settings.banner_radius | default: 0 }}px !important;
        overflow: hidden;
      }
      .how-to-use-banner-slideshow .slideshow,
      .how-to-use-banner-slideshow .item,
      .how-to-use-banner-slideshow .lookbook-image-item {
        margin: 0 !important;
        padding: 0 !important;
      }
      @media (min-width: 1025px) {
        {%- if section.settings.banner_fullwidth -%}
          .section-block-{{ section.id }} .container-full {
            padding-left: 0px !important;
            padding-right: 0px !important;
          }
        {%- endif -%}
      }
      @media (max-width: 767px) {
        #shopify-section-{{ section.id }} .how-to-use-banner-slideshow,
        .section-block-{{ section.id }}.how-to-use-banner-slideshow {
          padding-top: {{ banner_pt_mb }}px !important;
          padding-bottom: {{ banner_pb_mb }}px !important;
        }
        {%- if section.settings.banner_fullwidth -%}
          .section-block-{{ section.id }} .container-full {
            padding-left: 0px !important;
            padding-right: 0px !important;
          }
        {%- endif -%}
      }
    {%- endstyle -%}

    <div class="slideshow-wrapper section-block-{{ section.id }} how-to-use-banner-slideshow" id="slideshow-wrapper-{{ section.id }}" allow-transparent-header>
      {%- if show_heading -%}
        <div class="container" style="text-align: {{ section.settings.heading_alignment }}; margin-bottom: 20px;">
          <h2 id="{{ heading_id }}" class="how-to-use__heading" style="font-size: {{ section.settings.heading_size }}px; font-weight: {{ section.settings.heading_weight }}; color: {{ section.settings.heading_color }};">{{ section.settings.heading | escape }}</h2>
        </div>
      {%- endif -%}
      <div class="{% if section.settings.banner_fullwidth %}container-full{% else %}container{% endif %}">
        <div class="slideshow">
          <div class="item">
            <div class="images-contain lookbook-image-item">
              {%- if htu_banner_mobile != blank -%}
                <div class="adaptive_height image slide-mobile" style="padding-top: {% unless htu_banner_mobile.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: htu_banner_mobile.aspect_ratio | times: 120 }}%{% else %}{{ 1 | divided_by: htu_banner_mobile.aspect_ratio | times: 100 }}%{% endunless %};">
                  <a role="link" aria-disabled="true" title="{{ htu_banner_mobile.alt | default: shop.name | escape }}" class="slide-image">
                    <img srcset="{%- if htu_banner_mobile.width < 320 -%}{{ htu_banner_mobile | image_url: width: htu_banner_mobile.width }} 320w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 320 -%}{{ htu_banner_mobile | image_url: width: 375 }} 375w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 750 -%}{{ htu_banner_mobile | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 1100 -%}{{ htu_banner_mobile | image_url: width: 1100 }} 1100w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 1370 -%}{{ htu_banner_mobile | image_url: width: 1370 }} 1370w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 1500 -%}{{ htu_banner_mobile | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 1780 -%}{{ htu_banner_mobile | image_url: width: 1780 }} 1780w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 2000 -%}{{ htu_banner_mobile | image_url: width: 2000 }} 2000w,{%- endif -%}
                        {%- if htu_banner_mobile.width >= 2800 -%}{{ htu_banner_mobile | image_url: width: 2800 }} 2800w{%- endif -%}"
                        sizes="100vw"
                        src="{{ htu_banner_mobile | image_url: width: 750 }}"
                        alt="{{ htu_banner_mobile.alt | default: shop.name | escape }}"
                        width="{{ htu_banner_mobile.width }}"
                        height="{{ htu_banner_mobile.width | divided_by: htu_banner_mobile.aspect_ratio | round }}"
                        loading="lazy"
                        {% unless htu_banner_mobile.presentation.focal_point == '50.0% 50.0%' %}style="object-position: {{ htu_banner_mobile.presentation.focal_point }}"{% endunless %}
                    >
                  </a>
                </div>
              {%- endif -%}

              {%- if htu_banner_desktop != blank -%}
                <div class="adaptive_height image{% if htu_banner_mobile != blank %} slide-pc{% endif %}" style="padding-top: {% unless htu_banner_desktop.presentation.focal_point == '50.0% 50.0%' %}{{ 1 | divided_by: htu_banner_desktop.aspect_ratio | times: 110 }}%; --padding-top-fpmb: {{ 1 | divided_by: htu_banner_desktop.aspect_ratio | times: 200 }}%{% else %}{{ 1 | divided_by: htu_banner_desktop.aspect_ratio | times: 100 }}%{% endunless %};">
                  <a role="link" aria-disabled="true" title="{{ htu_banner_desktop.alt | default: shop.name | escape }}" class="slide-image">
                    <img srcset="{%- if htu_banner_desktop.width < 320 -%}{{ htu_banner_desktop | image_url: width: htu_banner_desktop.width }} 320w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 320 -%}{{ htu_banner_desktop | image_url: width: 375 }} 375w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 740 -%}{{ htu_banner_desktop | image_url: width: 740 }} 740w,{%- endif -%} 
                        {%- if htu_banner_desktop.width >= 750 -%}{{ htu_banner_desktop | image_url: width: 750 }} 750w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1100 -%}{{ htu_banner_desktop | image_url: width: 1100 }} 1100w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1370 -%}{{ htu_banner_desktop | image_url: width: 1370 }} 1370w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1500 -%}{{ htu_banner_desktop | image_url: width: 1500 }} 1500w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1770 -%}{{ htu_banner_desktop | image_url: width: 1770 }} 1770w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1780 -%}{{ htu_banner_desktop | image_url: width: 1780 }} 1780w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 1880 -%}{{ htu_banner_desktop | image_url: width: 1880 }} 1880w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 2000 -%}{{ htu_banner_desktop | image_url: width: 2000 }} 2000w,{%- endif -%}
                        {%- if htu_banner_desktop.width >= 2800 -%}{{ htu_banner_desktop | image_url: width: 2800 }} 2800w{%- endif -%}"
                        sizes="100vw"
                        src="{{ htu_banner_desktop | image_url: width: 1500 }}"
                        alt="{{ htu_banner_desktop.alt | default: shop.name | escape }}"
                        width="{{ htu_banner_desktop.width }}"
                        height="{{ htu_banner_desktop.width | divided_by: htu_banner_desktop.aspect_ratio | round }}"
                        loading="lazy"
                        {% unless htu_banner_desktop.presentation.focal_point == '50.0% 50.0%' %}style="object-position: {{ htu_banner_desktop.presentation.focal_point }}"{% endunless %}
                    >
                  </a>
                </div>
              {%- endif -%}
            </div>
          </div>
        </div>
      </div>
    </div>
  {%- else -%}
    <section
      id="HowToUse-{{ section.id }}"
      class="how-to-use how-to-use--{{ section.settings.container }} how-to-use--cards-{{ section.settings.card_alignment }}{% if single_row_desktop %} how-to-use--single-row-desktop{% endif %}{% if single_row_mobile %} how-to-use--single-row-mobile{% endif %}"
      {% if show_heading %}
        aria-labelledby="{{ heading_id }}"
      {% elsif section.settings.heading != blank %}
        aria-label="{{ section.settings.heading | escape }}"
      {% endif %}
    >
      <div class="how-to-use__inner">
        {%- if show_heading -%}
          <h2 id="{{ heading_id }}" class="how-to-use__heading">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}

        <div class="how-to-use__slider-wrap" data-htu-slider>
          {%- if section.settings.show_arrows != false -%}
            <button
              type="button"
              class="how-to-use__arrow how-to-use__arrow--prev"
              data-htu-prev
              aria-label="Previous step"
              disabled
            >
              {% render 'icon-chevron-left' %}
            </button>
          {%- endif -%}
          <ol class="how-to-use__grid" role="list">
          {%- assign step_number = 0 -%}
          {%- for step in product.metafields.custom[steps_key].value -%}
            {%- liquid
              assign step_number = step_number | plus: 1
              assign step_title = step.step_title.value | strip
              if step_title == blank
                assign step_title = step.step_title | metafield_text | strip
              endif
              if step_title == blank
                assign step_title = step.system.display_name | strip
              endif
              assign step_instruction = step.step_instruction.value | strip
              if step_instruction == blank
                assign step_instruction = step.step_instruction | metafield_text | strip
              endif
              assign step_file = step.step_image.value | default: step.step_image
              assign step_image = blank
              if step_file.media_type == 'image'
                assign step_image = step_file
              elsif step_file.preview_image != blank
                assign step_image = step_file.preview_image
              elsif step_file.media_type == blank and step_file.width != blank
                assign step_image = step_file
              endif
              assign has_image = false
              if step_image != blank
                assign has_image = true
              endif
              assign show_media = false
              if has_image
                assign show_media = true
              elsif section.settings.show_placeholder
                assign show_media = true
              endif
              assign show_title = false
              if section.settings.show_titles and step_title != blank
                assign show_title = true
              endif
              assign show_instruction = false
              if section.settings.show_instructions and step_instruction != blank
                assign show_instruction = true
              endif
            -%}
            <li class="how-to-use__card">
              {%- if show_media -%}
                <div class="{{ media_class }}{% unless has_image %} how-to-use__media--empty{% endunless %}">
                  {%- if has_image -%}
                    {%- assign image_alt = step_image.alt | strip -%}
                    {%- if image_alt == blank -%}
                      {%- if step_title != blank -%}
                        {%- assign image_alt = step_title -%}
                      {%- else -%}
                        {%- assign image_alt = 'Step ' | append: step_number -%}
                      {%- endif -%}
                    {%- endif -%}
                    {{ step_image | image_url: width: 1200 | image_tag: widths: '300, 450, 600, 900, 1200', sizes: '(min-width: 990px) 30vw, (min-width: 750px) 45vw, 90vw', alt: image_alt, loading: 'lazy', class: 'how-to-use__img' }}
                  {%- elsif section.settings.placeholder_text != blank -%}
                    <p class="how-to-use__placeholder">{{ section.settings.placeholder_text | escape | replace: '[step]', step_number }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}

              {%- if section.settings.show_numbers or show_title or show_instruction -%}
                <div class="how-to-use__body">
                  {%- if section.settings.show_numbers or show_title -%}
                    <div class="how-to-use__title-row">
                      {%- if section.settings.show_numbers -%}
                        <span class="how-to-use__badge"{% if show_title %} aria-hidden="true"{% else %} aria-label="Step {{ step_number }}"{% endif %}>{{ step_number }}</span>
                      {%- endif -%}
                      {%- if show_title -%}
                        <h3 class="how-to-use__title">
                          <span class="how-to-use__sr">Step {{ step_number }}. </span>
                          {{ step_title | escape }}
                        </h3>
                      {%- endif -%}
                    </div>
                  {%- endif -%}
                  {%- if show_instruction -%}
                    <p class="how-to-use__text">{{ step_instruction | escape | newline_to_br }}</p>
                  {%- endif -%}
                </div>
              {%- endif -%}
            </li>
          {%- endfor -%}
        </ol>
          {%- if section.settings.show_arrows != false -%}
            <button
              type="button"
              class="how-to-use__arrow how-to-use__arrow--next"
              data-htu-next
              aria-label="Next step"
            >
              {% render 'icon-chevron-right' %}
            </button>
          {%- endif -%}
        </div>
      </div>
    </section>
  {%- endif -%}

  <script>
    (function () {
      function initHowToUseSlider() {
        var wraps = document.querySelectorAll('#shopify-section-{{ section.id }} [data-htu-slider]');
        wraps.forEach(function (wrap) {
          var grid = wrap.querySelector('.how-to-use__grid');
          var prevBtn = wrap.querySelector('[data-htu-prev]');
          var nextBtn = wrap.querySelector('[data-htu-next]');
          if (!grid) return;

          function equalizeCardHeights() {
            var cards = grid.querySelectorAll('.how-to-use__card');
            if (!cards || cards.length === 0) return;
            cards.forEach(function (card) { card.style.minHeight = ''; });
            var maxH = 0;
            cards.forEach(function (card) {
              var h = card.offsetHeight;
              if (h > maxH) maxH = h;
            });
            if (maxH > 0) {
              cards.forEach(function (card) {
                card.style.minHeight = maxH + 'px';
              });
            }
          }

          function updateArrows() {
            if (!prevBtn || !nextBtn) return;
            var maxScroll = grid.scrollWidth - grid.clientWidth;
            var isScrollable = maxScroll > 4;

            if (!isScrollable) {
              prevBtn.style.display = 'none';
              nextBtn.style.display = 'none';
              return;
            }

            prevBtn.style.display = 'flex';
            nextBtn.style.display = 'flex';

            var atStart = grid.scrollLeft <= 4;
            var atEnd = grid.scrollLeft >= maxScroll - 6;

            prevBtn.disabled = atStart;
            prevBtn.setAttribute('aria-disabled', atStart ? 'true' : 'false');
            nextBtn.disabled = atEnd;
            nextBtn.setAttribute('aria-disabled', atEnd ? 'true' : 'false');
          }

          function updateLayout() {
            equalizeCardHeights();
            updateArrows();
          }

          if (prevBtn) {
            prevBtn.addEventListener('click', function (e) {
              e.preventDefault();
              var card = grid.querySelector('.how-to-use__card');
              var step = card ? card.offsetWidth + 12 : 260;
              grid.scrollBy({ left: -step, behavior: 'smooth' });
            });
          }

          if (nextBtn) {
            nextBtn.addEventListener('click', function (e) {
              e.preventDefault();
              var card = grid.querySelector('.how-to-use__card');
              var step = card ? card.offsetWidth + 12 : 260;
              grid.scrollBy({ left: step, behavior: 'smooth' });
            });
          }

          var imgs = grid.querySelectorAll('img');
          imgs.forEach(function (img) {
            if (!img.complete) {
              img.addEventListener('load', updateLayout);
            }
          });

          grid.addEventListener('scroll', updateArrows, { passive: true });
          window.addEventListener('resize', updateLayout);
          setTimeout(updateLayout, 100);
          setTimeout(updateLayout, 400);
          setTimeout(updateLayout, 1000);
        });
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initHowToUseSlider);
      } else {
        initHowToUseSlider();
      }
      document.addEventListener('shopify:section:load', function (e) {
        if (e.detail && e.detail.sectionId === '{{ section.id }}') {
          initHowToUseSlider();
        }
      });
    })();
  </script>
{%- else -%}
  {% style %}
    #shopify-section-{{ section.id }} {
      display: none;
    }
  {% endstyle %}
{%- endif -%}

{% stylesheet %}
  .how-to-use,
  .how-to-use *,
  .how-to-use *::before,
  .how-to-use *::after {
