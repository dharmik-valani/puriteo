    max-width: 100%;
    background: var(--htu-bg, #ffffff);
    color: var(--htu-title, #171521);
    font-family: var(--font-body-family);
    font-style: var(--font-body-style);
    color-scheme: light;
    overflow-x: hidden;
  }

  .how-to-use--page {
    width: min(100%, var(--htu-max-width, 1200px));
    margin-inline: auto;
  }

  .how-to-use__inner {
    width: 100%;
    margin-inline: auto;
    padding: var(--htu-pt, 48px) var(--htu-pr, 20px) var(--htu-pb, 56px) var(--htu-pl, 20px);
  }

  .how-to-use--full .how-to-use__inner {
    max-width: var(--htu-max-width, 1200px);
  }

  .how-to-use__heading {
    margin: 0 0 var(--htu-heading-gap, 36px);
    color: var(--htu-heading, #171521);
    font-family: var(--font-body-family);
    font-style: normal;
    font-size: var(--htu-heading-size, 40px);
    font-weight: var(--htu-heading-weight, 700);
    letter-spacing: -0.03em;
    line-height: 1.15;
    text-align: var(--htu-heading-align, center);
    text-transform: none;
  }

  .how-to-use__slider-wrap {
    position: relative;
    width: 100%;
  }

  .how-to-use__banner-wrap {
    position: relative;
    width: 100%;
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--htu-banner-radius, 0px);
    line-height: 0;
  }

  .how-to-use__banner-wrap .adaptive_height {
    border-radius: var(--htu-banner-radius, 0px);
    overflow: hidden;
  }

  .how-to-use__banner-wrap .slide-image {
    display: block;
    width: 100%;
    height: 100%;
  }

  .how-to-use--banner-fullwidth {
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .how-to-use--banner-fullwidth .how-to-use__inner {
    max-width: 100% !important;
    padding-left: 0 !important;
    padding-right: 0 !important;
  }

  .how-to-use--banner-mode.how-to-use--no-heading {
    padding-top: 0 !important;
    padding-bottom: 0 !important;
  }

  .how-to-use__arrow {
    position: absolute;
    top: 50% !important;
    transform: translateY(-50%) !important;
    width: 36px;
    height: 36px;
    min-width: 36px;
    border-radius: 50%;
    background: #ffffff !important;
    border: 1px solid rgba(0, 0, 0, 0.08) !important;
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.15) !important;
    color: #171521 !important;
    display: none;
    align-items: center !important;
    justify-content: center !important;
    cursor: pointer;
    z-index: 6;
    padding: 0 !important;
    margin: 0 !important;
    line-height: 0 !important;
    transition: opacity 0.2s ease, transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
  }

  .how-to-use__arrow:hover:not(:disabled) {
    background: #ffffff !important;
    transform: translateY(-50%) scale(1.06) !important;
    box-shadow: 0 5px 14px rgba(0, 0, 0, 0.2) !important;
  }

  .how-to-use__arrow:active:not(:disabled) {
    transform: translateY(-50%) scale(0.95) !important;
  }

  .how-to-use__arrow--prev {
    left: 8px;
  }

  .how-to-use__arrow--next {
    right: 8px;
  }

  .how-to-use__arrow svg,
  .how-to-use__arrow .icon {
    width: 12px !important;
    height: 12px !important;
    min-width: 12px !important;
    min-height: 12px !important;
    max-width: 12px !important;
    max-height: 12px !important;
    fill: currentColor !important;
    stroke: none !important;
    display: block !important;
    margin: 0 auto !important;
    pointer-events: none !important;
  }

  .how-to-use__arrow--prev svg,
  .how-to-use__arrow--prev .icon {
    transform: translateX(-1px) !important;
  }

  .how-to-use__arrow--next svg,
  .how-to-use__arrow--next .icon {
    transform: translateX(1px) !important;
  }

  .how-to-use__arrow:disabled,
  .how-to-use__arrow[aria-disabled="true"] {
    opacity: 0.25 !important;
    cursor: default !important;
    pointer-events: none !important;
  }

  .how-to-use__grid {
    display: grid;
    grid-template-columns: repeat(var(--htu-cols, 3), minmax(0, 1fr));
    gap: var(--htu-gap, 24px);
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .how-to-use__card {
    display: flex;
    flex-direction: column;
    min-width: 0;
    height: 100%;
    margin: 0;
    padding: var(--htu-card-pad, 18px);
    background: var(--htu-card-bg, #f2ecff);
    border: var(--htu-border-width, 0px) solid var(--htu-border, transparent);
    border-radius: var(--htu-card-radius, 28px);
  }

  .how-to-use__media {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    width: var(--htu-image-width, 100%);
    max-width: 100%;
    margin-inline: auto;
    overflow: hidden;
    aspect-ratio: var(--htu-ratio, 4 / 3);
    border-radius: var(--htu-image-radius, 20px);
    background: var(--htu-image-bg, #ffffff);
  }

  .how-to-use__media--empty {
    background: var(--htu-placeholder-bg, #ffffff);
  }

  .how-to-use__media--natural {
    aspect-ratio: auto;
    min-height: 180px;
  }

  .how-to-use__media .how-to-use__img {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: var(--htu-fit, cover);
    border: 0;
    border-radius: inherit;
  }

  .how-to-use__media--natural .how-to-use__img {
    position: relative;
    inset: auto;
    height: auto;
  }

  .how-to-use__placeholder {
    max-width: 180px;
    margin: 0;
    padding: 16px;
    color: var(--htu-text, #6e6b78);
    font-size: 14px;
    font-weight: 400;
    line-height: 1.4;
    text-align: center;
  }

  .how-to-use__body {
    display: flex;
    flex-direction: column;
    flex: 1 1 auto;
    min-width: 0;
  }

  .how-to-use__media + .how-to-use__body {
    margin-top: var(--htu-image-gap, 16px);
  }

  .how-to-use__title-row {
    display: flex;
    align-items: center;
    gap: 10px;
    min-width: 0;
  }

  .how-to-use__badge {
    display: inline-flex;
    flex: 0 0 26px;
    align-items: center;
    justify-content: center;
    width: 26px;
    height: 26px;
    border-radius: 50%;
    background: var(--htu-badge-bg, #171521);
    color: var(--htu-badge-text, #ffffff);
    font-size: 13px;
    font-weight: 700;
    line-height: 1;
  }

  .how-to-use__title {
    margin: 0;
    min-width: 0;
    color: var(--htu-title, #171521);
    font-family: var(--font-body-family);
    font-style: normal;
    font-size: var(--htu-title-size, 15px);
    font-weight: var(--htu-title-weight, 700);
    letter-spacing: -0.01em;
    line-height: 1.25;
    text-transform: none;
    overflow-wrap: anywhere;
  }

  .how-to-use__text {
    margin: var(--htu-text-gap, 6px) 0 0;
    color: var(--htu-text, #6e6b78);
    font-size: var(--htu-text-size, 13px);
    font-weight: 400;
    line-height: var(--htu-text-lh, 1.45);
    overflow-wrap: anywhere;
  }

  .how-to-use--cards-center .how-to-use__card,
  .how-to-use--cards-center .how-to-use__text {
    text-align: center;
  }

  .how-to-use--cards-center .how-to-use__title-row {
    justify-content: center;
  }

  .how-to-use--cards-right .how-to-use__card,
  .how-to-use--cards-right .how-to-use__text {
    text-align: right;
  }

  .how-to-use--cards-right .how-to-use__title-row {
    justify-content: flex-end;
  }

  .how-to-use__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }

  @media screen and (min-width: 1025px) {
    .how-to-use--single-row-desktop .how-to-use__grid {
      display: grid !important;
      grid-template-columns: repeat(var(--htu-cols, 5), minmax(0, 1fr)) !important;
      gap: var(--htu-gap, 14px) !important;
      width: 100% !important;
    }
  }

  @media screen and (min-width: 750px) and (max-width: 1024px) {
    .how-to-use--single-row-desktop .how-to-use__inner {
      padding-left: 0;
      padding-right: 0;
    }

    .how-to-use--single-row-desktop .how-to-use__heading {
      padding-inline: 24px;
    }

    .how-to-use--single-row-desktop .how-to-use__grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      align-items: stretch !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      gap: 14px !important;
      padding: 4px 24px 16px 24px !important;
      scrollbar-width: thin;
    }

    .how-to-use--single-row-desktop .how-to-use__card {
      flex: 0 0 240px !important;
      height: auto !important;
      align-self: stretch !important;
      display: flex !important;
      flex-direction: column !important;
      scroll-snap-align: start !important;
    }
  }

  @media screen and (max-width: 989px) {
    .how-to-use:not(.how-to-use--single-row-desktop) .how-to-use__grid {
      grid-template-columns: repeat(var(--htu-cols-tablet, 2), minmax(0, 1fr));
    }
  }

  @media screen and (max-width: 749px) {
    .how-to-use__inner {
      padding: var(--htu-pt-mobile, 32px) var(--htu-pr-mobile, 16px) var(--htu-pb-mobile, 36px) var(--htu-pl-mobile, 16px) !important;
    }

    .how-to-use--single-row-mobile .how-to-use__heading {
      margin-bottom: 20px;
      font-size: var(--htu-heading-size-mobile, 28px);
    }

    .how-to-use--single-row-mobile .how-to-use__grid {
      display: flex !important;
      flex-wrap: nowrap !important;
      align-items: stretch !important;
      overflow-x: auto !important;
      scroll-snap-type: x mandatory !important;
      -webkit-overflow-scrolling: touch !important;
      gap: 12px !important;
      padding: 4px 0 6px 0 !important;
      margin: 0 !important;
      scrollbar-width: none;
    }

    .how-to-use--single-row-mobile .how-to-use__grid::-webkit-scrollbar {
      display: none;
    }

    .how-to-use--single-row-mobile .how-to-use__card {
      flex: 0 0 76% !important;
      min-width: 240px !important;
      max-width: 285px !important;
      height: auto !important;
      align-self: stretch !important;
      display: flex !important;
      flex-direction: column !important;
      scroll-snap-align: start !important;
      padding: 12px !important;
      border-radius: 20px !important;
    }

    .how-to-use--single-row-mobile .how-to-use__body {
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
    }

    .how-to-use--single-row-mobile .how-to-use__media {
      border-radius: 14px !important;
    }

    .how-to-use--single-row-mobile .how-to-use__arrow {
      top: 50% !important;
      transform: translateY(-50%) !important;
    }

    .how-to-use--single-row-mobile .how-to-use__arrow--prev {
      left: 0 !important;
    }

    .how-to-use--single-row-mobile .how-to-use__arrow--next {
      right: 0 !important;
    }

    .how-to-use:not(.how-to-use--single-row-mobile) .how-to-use__heading {
      margin-bottom: var(--htu-heading-gap-mobile, 24px);
      font-size: var(--htu-heading-size-mobile, 30px);
    }

    .how-to-use:not(.how-to-use--single-row-mobile) .how-to-use__grid {
      grid-template-columns: repeat(var(--htu-cols-mobile, 1), minmax(0, 1fr));
      gap: var(--htu-gap-mobile, 16px);
    }

    .how-to-use:not(.how-to-use--single-row-mobile) .how-to-use__card {
      padding: var(--htu-card-pad-mobile, 14px);
    }

    .how-to-use__media + .how-to-use__body {
      margin-top: var(--htu-image-gap-mobile, 12px);
    }

    .how-to-use__title {
      font-size: var(--htu-title-size-mobile, 15px);
    }

    .how-to-use__text,
    .how-to-use__placeholder {
      font-size: var(--htu-text-size-mobile, 12px);
    }

    .how-to-use--banner-fullwidth {
      padding-left: 0 !important;
      padding-right: 0 !important;
    }

    .how-to-use--banner-fullwidth .how-to-use__inner {
      max-width: 100% !important;
      padding-left: 0 !important;
      padding-right: 0 !important;
    }
  }
