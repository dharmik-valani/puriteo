<section class="bb-pro">
  <div class="container">
    
    <h1 class="bb-heading">{{ section.settings.heading }}</h1>
    <p class="bb-sub">{{ section.settings.subheading }}</p>

    <!-- TOP ROW -->
    <div class="bb-grid top">
      {% for block in section.blocks %}
        {% if block.type == 'top_card' %}
        <div class="bb-card">
          <div class="img-wrap">
            <img src="{{ block.settings.image | image_url }}" />
            <div class="overlay">
              <h2>{{ block.settings.overlay_title }}</h2>
              <p>{{ block.settings.overlay_sub }}</p>
            </div>
          </div>

          <div class="bb-info">
            <span class="title">{{ block.settings.title }}</span>
            <span class="price">{{ block.settings.price }}</span>
          </div>

          <a href="{{ block.settings.link }}" class="bb-btn">BUILD YOUR OWN BOX</a>
        </div>
        {% endif %}
      {% endfor %}
    </div>

    <!-- BOTTOM ROW -->
    <div class="bb-grid bottom">
      {% for block in section.blocks %}
        {% if block.type == 'bottom_card' %}
        <div class="bb-card large">
          <div class="img-wrap">
            <img src="{{ block.settings.image | image_url }}" />
            <div class="overlay big">
              <h2>{{ block.settings.overlay_title }}</h2>
              <p>{{ block.settings.overlay_sub }}</p>
            </div>
          </div>

          <div class="bb-info">
            <span class="title">{{ block.settings.title }}</span>
            <span class="price">{{ block.settings.price }}</span>
          </div>

          <a href="{{ block.settings.link }}" class="bb-btn">BUILD YOUR OWN BOX</a>
        </div>
        {% endif %}
      {% endfor %}
    </div>

  </div>
</section>

<style>
.bb-pro { padding: 40px 20px; text-align:center; }
.bb-heading { font-size: 42px; font-weight: 700; }
.bb-sub { margin-bottom: 30px; }

.bb-grid.top {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 18px;
}

.bb-grid.bottom {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 18px;
  margin-top: 30px;
}

.bb-card {
  background:#fff;
  border-radius:14px;
  overflow:hidden;
  border:1px solid #eee;
}

.img-wrap { position:relative; }
.img-wrap img { width:100%; display:block; }

.overlay {
  position:absolute;
  top:15px;
  left:15px;
  color:#fff;
}
.overlay h2 { font-size:24px; margin:0; }
.overlay p { margin:5px 0 0; }

.overlay.big h2 { font-size:32px; }

.bb-info {
  display:flex;
  justify-content:space-between;
  padding:12px;
  font-weight:600;
}

.bb-btn {
  display:block;
  background:#393185;
  color:#fff;
  padding:12px;
  text-decoration:none;
  font-weight:600;
}

@media(max-width:768px){
  .bb-grid.top { grid-template-columns:1fr; }
  .bb-grid.bottom { grid-template-columns:1fr; }
}
</style>

{% schema %}
{
  "name": "Box Builder Pro",
  "settings": [
    { "type": "text", "id": "heading", "default": "Build your own box with P", "label": "Heading" },
    { "type": "text", "id": "subheading", "default": "Pick your favorite products and save big!", "label": "Subheading" }
  ],
  "blocks": [
    {
      "type": "top_card",
      "name": "Top Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overlay_title", "label": "Overlay Title" },
        { "type": "text", "id": "overlay_sub", "label": "Overlay Subtext" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    },
    {
      "type": "bottom_card",
      "name": "Bottom Card",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "overlay_title", "label": "Overlay Title" },
        { "type": "text", "id": "overlay_sub", "label": "Overlay Subtext" },
        { "type": "text", "id": "title", "label": "Title" },
        { "type": "text", "id": "price", "label": "Price" },
        { "type": "url", "id": "link", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "Box Builder Pro" }
  ]
}
{% endschema %}