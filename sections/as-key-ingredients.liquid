        display: grid !important;
        grid-template-columns: repeat({{ mobile_columns }}, 1fr) !important;
        gap: {{ section.settings.grid_gap_mobile | default: 16 }}px;
        width: 100%;
        justify-items: center !important;
        align-items: start !important;
      }

