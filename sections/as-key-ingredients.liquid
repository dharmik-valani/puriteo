  <script>
    (function() {
      var section = document.getElementById('as-key-ingredients-{{ section.id }}');
      if (!section) return;

      var grid = section.querySelector('[data-as-ki-grid]');
      if (!grid) return;

      var prevBtn = section.querySelector('[data-as-ki-prev]');
      var nextBtn = section.querySelector('[data-as-ki-next]');
      var desktopDots = section.querySelectorAll('.as-key-ingredients__dots-wrap--desktop .as-key-ingredients__dot');
      var mobileDots = section.querySelectorAll('.as-key-ingredients__dots-wrap--mobile .as-key-ingredients__dot');

      function getStep() {
        var card = grid.querySelector('.as-key-ingredients__card');
        var gap = 24;
        if (window.innerWidth <= 820) {
          gap = {{ section.settings.grid_gap_mobile | default: 16 }};
        } else {
          gap = {{ section.settings.grid_gap_desktop | default: 28 }};
        }
        return card ? (card.offsetWidth + gap) : 280;
      }

      function updateArrows() {
        if (!prevBtn && !nextBtn) return;
        var maxScroll = grid.scrollWidth - grid.clientWidth;
        if (maxScroll <= 4) {
          if (prevBtn) prevBtn.disabled = true;
          if (nextBtn) nextBtn.disabled = true;
          return;
        }
        if (prevBtn) {
          prevBtn.disabled = grid.scrollLeft <= 4;
        }
        if (nextBtn) {
          nextBtn.disabled = grid.scrollLeft >= maxScroll - 4;
        }
      }

      if (prevBtn) {
        prevBtn.addEventListener('click', function() {
          grid.scrollBy({ left: -getStep(), behavior: 'smooth' });
        });
      }

      if (nextBtn) {
        nextBtn.addEventListener('click', function() {
          grid.scrollBy({ left: getStep(), behavior: 'smooth' });
        });
      }

      if (desktopDots.length > 0) {
        desktopDots.forEach(function(dot, idx) {
          dot.addEventListener('click', function() {
            grid.scrollTo({ left: idx * getStep(), behavior: 'smooth' });
          });
        });
      }

      grid.addEventListener('scroll', function() {
        updateArrows();
        var step = getStep();
        if (step <= 0) return;
        var activeIndex = Math.round(grid.scrollLeft / step);

        if (desktopDots.length > 0) {
          desktopDots.forEach(function(dot, idx) {
            if (idx === activeIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }

        if (mobileDots.length > 0) {
          mobileDots.forEach(function(dot, idx) {
            if (idx === activeIndex) {
              dot.classList.add('active');
            } else {
              dot.classList.remove('active');
            }
          });
        }
      }, { passive: true });

      window.addEventListener('resize', updateArrows);
      setTimeout(updateArrows, 150);
    })();
  </script>
{%- else -%}
  <style>
    #shopify-section-{{ section.id }} {
      display: none !important;
    }
  </style>
  <script>
    (function() {
      var s = document.getElementById('shopify-section-{{ section.id }}');
      if (s) s.style.display = 'none';
    })();
  </script>
{%- endif -%}

