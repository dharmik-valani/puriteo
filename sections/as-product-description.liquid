{%- liquid
  assign heading = section.settings.heading | default: 'Description'
  assign default_open = section.settings.default_open | default: false

  assign icon_size_desk = section.settings.icon_size_desktop | default: 36
  assign icon_svg_desk = icon_size_desk | minus: 12
  assign icon_size_mob = section.settings.icon_size_mobile | default: 32
  assign icon_svg_mob = icon_size_mob | minus: 10

  assign container_class = 'container'
  if section.settings.container == 'fullwidth'
    assign container_class = 'container-full'
  elsif section.settings.container == '1170'
    assign container_class = 'container-1170'
  elsif section.settings.container == '1770'
    assign container_class = 'container-1770'
  endif

  # 1. Product Description (from product only)
  assign desc_content = ''
  if product.metafields.custom.long_description != blank
    assign desc_rich = product.metafields.custom.long_description | metafield_tag
    assign desc_plain = product.metafields.custom.long_description.value | default: product.metafields.custom.long_description
    if desc_rich != blank and desc_rich != ''
      assign desc_content = desc_rich
    elsif desc_plain != blank
      assign desc_content = desc_plain | newline_to_br
    endif
  endif
  if desc_content == blank and product.description != blank
    assign desc_content = product.description
  endif

  # 2. Key Features (from product only)
  assign kf_text = ''
  if product.metafields.custom.features_text != blank
    assign kf_rich = product.metafields.custom.features_text | metafield_tag
    assign kf_plain = product.metafields.custom.features_text.value | default: product.metafields.custom.features_text
    if kf_rich != blank and kf_rich != ''
      assign kf_text = kf_rich
    elsif kf_plain != blank
      assign kf_text = kf_plain | newline_to_br
    endif
  endif

  # 3. Health Benefits (from product only)
  assign hb_text = ''
  if product.metafields.custom.benefits_text != blank
    assign hb_rich = product.metafields.custom.benefits_text | metafield_tag
    assign hb_plain = product.metafields.custom.benefits_text.value | default: product.metafields.custom.benefits_text
    if hb_rich != blank and hb_rich != ''
      assign hb_text = hb_rich
    elsif hb_plain != blank
      assign hb_text = hb_plain | newline_to_br
    endif
  endif

  assign has_content = false
  assign desc_clean = desc_content | strip_html | strip
  assign kf_clean = kf_text | strip_html | strip
  assign hb_clean = hb_text | strip_html | strip
  if desc_clean != blank or kf_clean != blank or hb_clean != blank
    assign has_content = true
  endif
-%}

{%- if has_content -%}
  <section
    class="as-product-description section-block-{{ section.id }}"
    id="as-product-description-{{ section.id }}"
  >
    <div class="{{ container_class }}">
      <div class="as-desc__card as-desc__accordion{% if default_open %} is-open{% endif %}" data-as-accordion>
        <!-- Accordion Header Trigger -->
        <button
          type="button"
          class="as-desc__accordion-trigger"
          id="as-desc-trigger-{{ section.id }}"
          aria-expanded="{% if default_open %}true{% else %}false{% endif %}"
          aria-controls="as-desc-panel-{{ section.id }}"
        >
          <span class="as-desc__heading">{{ heading }}</span>
          <span class="as-desc__accordion-icon" aria-hidden="true">
            <svg class="as-desc__icon-chevron" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
              <path d="M6 9l6 6 6-6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </span>
        </button>

        <!-- Accordion Content Panel -->
        <div
          class="as-desc__accordion-panel"
          id="as-desc-panel-{{ section.id }}"
          role="region"
          aria-labelledby="as-desc-trigger-{{ section.id }}"
          {% unless default_open %}style="display: none;"{% endunless %}
        >
          <div class="as-desc__accordion-inner">
            <!-- Main Product Description Body -->
            {%- if desc_clean != blank -%}
              <div class="pdp_tab_content_body as-desc__body rte">
                {{ desc_content }}
              </div>
            {%- endif -%}

            <!-- Key Features & Health Benefits Sub-Tabs (as in product information block) -->
            {%- if kf_clean != blank or hb_clean != blank -%}
              <div class="product_tab_main as-desc__subtabs">
                <div class="product_tab_inner">
                  <div class="productdetails_title as-desc__subtab-nav">
                    {%- if kf_clean != blank -%}
                      <div class="pdp_tab_container_title pdp-card active-card" data-tab="tab_key_features-{{ section.id }}">
                        <div>{{ section.settings.key_features_title | default: 'Key features:' }}</div>
                      </div>
                    {%- endif -%}
                    {%- if hb_clean != blank -%}
                      <div class="pdp_tab_container_title pdp-card{% if kf_clean == blank %} active-card{% endif %}" data-tab="tab_health_benefits-{{ section.id }}">
                        <div>{{ section.settings.health_benefits_title | default: 'Health benefits:' }}</div>
                      </div>
                    {%- endif -%}
                  </div>

                  <div class="pdp_tab_detils_cover as-desc__subtab-content">
                    {%- if kf_clean != blank -%}
                      <div class="pdp_tab_detils active_tabify rte" id="tab_key_features-{{ section.id }}">
                        {{ kf_text }}
                      </div>
                    {%- endif -%}
                    {%- if hb_clean != blank -%}
                      <div class="pdp_tab_detils{% if kf_clean == blank %} active_tabify{% endif %} rte" id="tab_health_benefits-{{ section.id }}">
                        <div>{{ hb_text }}</div>
                      </div>
                    {%- endif -%}
                  </div>
                </div>
              </div>
            {%- endif -%}
          </div>
        </div>
      </div>
    </div>
  </section>

  <style>
    #as-product-description-{{ section.id }} {
      background-color: {{ section.settings.bg_color | default: 'transparent' }};
      padding-top: {{ section.settings.padding_top_desktop | default: 35 }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop | default: 35 }}px;
      padding-left: 0 !important;
      padding-right: 0 !important;
      margin: 0;
      box-sizing: border-box;
      width: 100%;
    }

    #as-product-description-{{ section.id }} .container,
    #as-product-description-{{ section.id }} .container-1170,
    #as-product-description-{{ section.id }} .container-1770,
    #as-product-description-{{ section.id }} .container-full {
      padding-left: {{ section.settings.padding_side_desktop | default: 80 }}px !important;
      padding-right: {{ section.settings.padding_side_desktop | default: 80 }}px !important;
      margin-left: auto;
      margin-right: auto;
      width: 100%;
      box-sizing: border-box;
    }

    {% if section.settings.container == '1170' %}
      #as-product-description-{{ section.id }} .container-1170 {
        max-width: 1200px;
      }
    {% elsif section.settings.container == '1770' %}
      #as-product-description-{{ section.id }} .container-1770 {
        max-width: 1800px;
      }
    {% elsif section.settings.container == 'fullwidth' %}
      #as-product-description-{{ section.id }} .container-full {
        max-width: 100%;
      }
    {% else %}
      #as-product-description-{{ section.id }} .container {
        max-width: 100%;
      }
    {% endif %}

    #as-product-description-{{ section.id }} .as-desc__card {
      background: {{ section.settings.card_bg | default: '#ffffff' }};
      border: 1px solid {{ section.settings.card_border_color | default: '#e6eaf0' }};
      border-radius: {{ section.settings.card_radius | default: 16 }}px;
      box-shadow: {{ section.settings.card_shadow | default: '0 2px 12px rgba(0, 0, 0, 0.03)' }};
      box-sizing: border-box;
      width: 100%;
      overflow: hidden;
      transition: border-color 0.2s ease, box-shadow 0.2s ease;
    }

    /* Accordion Trigger */
    #as-product-description-{{ section.id }} .as-desc__accordion-trigger {
      width: 100%;
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: {{ section.settings.trigger_padding_y_desktop | default: 24 }}px {{ section.settings.trigger_padding_x_desktop | default: 32 }}px;
      background: transparent;
      border: none;
      cursor: pointer;
      text-align: left;
      color: {{ section.settings.heading_color | default: '#1b3a6e' }};
      user-select: none;
      transition: background-color 0.15s ease;
    }

    #as-product-description-{{ section.id }} .as-desc__accordion-trigger:hover {
      background-color: rgba(27, 58, 110, 0.02);
    }

    #as-product-description-{{ section.id }} .as-desc__heading {
      font-size: {{ section.settings.heading_size | default: 24 }}px;
      font-weight: 700;
      line-height: 1.25;
      color: inherit;
      margin: 0;
      letter-spacing: -0.01em;
    }

    #as-product-description-{{ section.id }} .as-desc__accordion-icon {
      display: flex;
      align-items: center;
      justify-content: center;
      width: {{ icon_size_desk }}px;
      height: {{ icon_size_desk }}px;
      border-radius: 8px;
      color: {{ section.settings.heading_color | default: '#1b3a6e' }};
      background: transparent;
      transition: transform 0.3s cubic-bezier(0.4, 0, 0.2, 1), background-color 0.2s ease;
      flex-shrink: 0;
      margin-left: 16px;
    }

    #as-product-description-{{ section.id }} .as-desc__icon-chevron {
      width: {{ icon_svg_desk }}px;
      height: {{ icon_svg_desk }}px;
    }

    #as-product-description-{{ section.id }} .as-desc__accordion-trigger:hover .as-desc__accordion-icon {
      background: rgba(27, 58, 110, 0.04);
    }

    #as-product-description-{{ section.id }} .as-desc__accordion.is-open .as-desc__accordion-icon,
    #as-product-description-{{ section.id }} .as-desc__accordion-trigger[aria-expanded="true"] .as-desc__accordion-icon {
      transform: rotate(180deg);
    }

    /* Accordion Panel */
    #as-product-description-{{ section.id }} .as-desc__accordion-panel {
      border-top: 1px solid {{ section.settings.card_border_color | default: '#e6eaf0' }};
    }

    #as-product-description-{{ section.id }} .as-desc__accordion-inner {
      padding: 24px {{ section.settings.trigger_padding_x_desktop | default: 32 }}px {{ section.settings.trigger_padding_y_desktop | default: 32 }}px;
      box-sizing: border-box;
    }

    #as-product-description-{{ section.id }} .as-desc__body {
      font-size: {{ section.settings.body_size | default: 14 }}px;
      line-height: 1.65;
      color: {{ section.settings.text_color | default: '#2b3b55' }};
      word-break: break-word;
    }

    #as-product-description-{{ section.id }} .as-desc__body p {
      margin-top: 0;
      margin-bottom: 1em;
      color: inherit;
      line-height: inherit;
    }

    #as-product-description-{{ section.id }} .as-desc__body p:last-child {
      margin-bottom: 0;
    }

    #as-product-description-{{ section.id }} .as-desc__body ul,
    #as-product-description-{{ section.id }} .as-desc__body ol {
      padding-left: 20px;
      margin-top: 0;
      margin-bottom: 1em;
    }

    #as-product-description-{{ section.id }} .as-desc__body li {
      margin-bottom: 6px;
      line-height: 1.55;
    }

    #as-product-description-{{ section.id }} .as-desc__body h1,
    #as-product-description-{{ section.id }} .as-desc__body h2,
    #as-product-description-{{ section.id }} .as-desc__body h3,
    #as-product-description-{{ section.id }} .as-desc__body h4 {
      color: {{ section.settings.heading_color | default: '#1b3a6e' }};
      margin-top: 1.2em;
      margin-bottom: 0.5em;
      font-weight: 700;
    }

    #as-product-description-{{ section.id }} .as-desc__body table {
      width: 100%;
      border-collapse: collapse;
      margin: 1.2em 0;
      font-size: 13px;
    }

    #as-product-description-{{ section.id }} .as-desc__body th,
    #as-product-description-{{ section.id }} .as-desc__body td {
      padding: 8px 12px;
      border: 1px solid #e2e8f0;
    }

    #as-product-description-{{ section.id }} .as-desc__body th {
      background: #f8fafc;
      font-weight: 600;
      color: #1b3a6e;
    }

    #as-product-description-{{ section.id }} .as-desc__body img {
      max-width: 100%;
      height: auto;
      border-radius: 8px;
    }

    /* Sub-tabs styling matching product information block */
    #as-product-description-{{ section.id }} .product_tab_main {
      margin-top: 24px;
      padding-top: 20px;
      border-top: 1px solid #eef2f6;
    }

    #as-product-description-{{ section.id }} .productdetails_title {
      display: flex;
      column-gap: 24px;
      border-bottom: 1px solid #eef2f6;
      padding-bottom: 2px;
    }

    #as-product-description-{{ section.id }} .pdp_tab_container_title {
      font-size: 14px !important;
      font-weight: 600;
      padding-bottom: 8px;
      cursor: pointer;
      border-bottom: 2px solid transparent;
      color: #5a7aad;
      transition: color 0.2s ease, border-color 0.2s ease;
    }

    #as-product-description-{{ section.id }} .pdp_tab_container_title.active-card,
    #as-product-description-{{ section.id }} .pdp_tab_container_title:hover {
      color: {{ section.settings.heading_color | default: '#1b3a6e' }};
      border-bottom-color: {{ section.settings.heading_color | default: '#1b3a6e' }};
    }

    #as-product-description-{{ section.id }} .pdp_tab_detils_cover {
      margin-top: 18px;
      font-size: {{ section.settings.body_size | default: 14 }}px;
      line-height: 1.65;
      color: {{ section.settings.text_color | default: '#2b3b55' }};
    }

    #as-product-description-{{ section.id }} .pdp_tab_detils:not(.active_tabify) {
      display: none !important;
    }

    /* Mobile */
    @media (max-width: 820px) {
      #as-product-description-{{ section.id }} {
        padding-top: {{ section.settings.padding_top_mobile | default: 25 }}px;
        padding-bottom: {{ section.settings.padding_bottom_mobile | default: 25 }}px;
      }

      #as-product-description-{{ section.id }} .container,
      #as-product-description-{{ section.id }} .container-1170,
      #as-product-description-{{ section.id }} .container-1770,
      #as-product-description-{{ section.id }} .container-full {
        padding-left: {{ section.settings.padding_side_mobile | default: 15 }}px !important;
        padding-right: {{ section.settings.padding_side_mobile | default: 15 }}px !important;
      }

      #as-product-description-{{ section.id }} .as-desc__card {
        border-radius: 12px;
      }

      #as-product-description-{{ section.id }} .as-desc__accordion-trigger {
        padding: {{ section.settings.trigger_padding_y_mobile | default: 18 }}px {{ section.settings.trigger_padding_x_mobile | default: 20 }}px;
      }

      #as-product-description-{{ section.id }} .as-desc__heading {
        font-size: {{ section.settings.heading_size_mobile | default: 20 }}px;
      }

      #as-product-description-{{ section.id }} .as-desc__accordion-icon {
        width: {{ icon_size_mob }}px;
        height: {{ icon_size_mob }}px;
        border-radius: 6px;
      }

      #as-product-description-{{ section.id }} .as-desc__icon-chevron {
        width: {{ icon_svg_mob }}px;
        height: {{ icon_svg_mob }}px;
      }

      #as-product-description-{{ section.id }} .as-desc__accordion-inner {
        padding: 18px {{ section.settings.trigger_padding_x_mobile | default: 20 }}px {{ section.settings.trigger_padding_y_mobile | default: 22 }}px;
      }

      #as-product-description-{{ section.id }} .as-desc__body,
      #as-product-description-{{ section.id }} .pdp_tab_detils_cover {
        font-size: {{ section.settings.body_size_mobile | default: 13 }}px;
        line-height: 1.6;
      }

      #as-product-description-{{ section.id }} .pdp_tab_container_title {
        font-size: 13px !important;
      }
    }
  </style>

  <script>
    (function() {
      var section = document.getElementById('as-product-description-{{ section.id }}');
      if (!section) return;

      // Accordion Toggle
      var card = section.querySelector('.as-desc__accordion');
      var trigger = section.querySelector('.as-desc__accordion-trigger');
      var panel = section.querySelector('.as-desc__accordion-panel');

      if (trigger && panel && card) {
        trigger.addEventListener('click', function() {
          var isExpanded = trigger.getAttribute('aria-expanded') === 'true';
          if (isExpanded) {
            trigger.setAttribute('aria-expanded', 'false');
            card.classList.remove('is-open');
            panel.style.display = 'none';
          } else {
            trigger.setAttribute('aria-expanded', 'true');
            card.classList.add('is-open');
            panel.style.display = 'block';
          }
        });
      }

      // Sub-Tabs Switching (Key Features / Health Benefits)
      var tabTitles = section.querySelectorAll('.productdetails_title .pdp_tab_container_title');
      var tabContents = section.querySelectorAll('.pdp_tab_detils_cover .pdp_tab_detils');

      for (var i = 0; i < tabTitles.length; i++) {
        tabTitles[i].addEventListener('click', function(e) {
          e.stopPropagation();
          var targetId = this.getAttribute('data-tab');
          for (var j = 0; j < tabTitles.length; j++) {
            tabTitles[j].classList.remove('active-card');
          }
          for (var k = 0; k < tabContents.length; k++) {
            tabContents[k].classList.remove('active_tabify');
          }
          this.classList.add('active-card');
          var targetEl = document.getElementById(targetId);
          if (targetEl) {
            targetEl.classList.add('active_tabify');
          }
        });
      }
    })();
  </script>
{%- else -%}
  <style>
    #shopify-section-{{ section.id }} {
      display: none !important;
    }
  </style>
  <script>
    (function() {
      var s = document.getElementById('shopify-section-{{ section.id }}');
      if (s) s.style.display = 'none';
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Product Description",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "header",
      "content": "Accordion Header"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Accordion Title",
      "default": "Description"
    },
    {
      "type": "checkbox",
      "id": "default_open",
      "label": "Open accordion by default",
      "default": false
    },
    {
      "type": "range",
      "id": "heading_size",
      "label": "Heading font size (Desktop)",
      "min": 18,
      "max": 36,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "heading_size_mobile",
      "label": "Heading font size (Mobile)",
      "min": 16,
      "max": 28,
      "step": 1,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Arrow Icon"
    },
    {
      "type": "range",
      "id": "icon_size_desktop",
      "label": "Arrow button size (Desktop)",
      "min": 24,
      "max": 56,
      "step": 2,
      "unit": "px",
      "default": 36
    },
    {
      "type": "range",
      "id": "icon_size_mobile",
      "label": "Arrow button size (Mobile)",
      "min": 20,
      "max": 44,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#1b3a6e"
    },
    {
      "type": "header",
      "content": "Sub-Tabs (from Product)"
    },
    {
      "type": "paragraph",
      "content": "Sub-tabs for Key Features and Health Benefits automatically display when configured in the product's metafields (custom.features_text & custom.benefits_text)."
    },
    {
      "type": "text",
      "id": "key_features_title",
      "label": "Key features tab label",
      "default": "Key features:"
    },
    {
      "type": "text",
      "id": "health_benefits_title",
      "label": "Health benefits tab label",
      "default": "Health benefits:"
    },
    {
      "type": "header",
      "content": "Typography & Colors"
    },
    {
      "type": "range",
      "id": "body_size",
      "label": "Body font size (Desktop)",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "body_size_mobile",
      "label": "Body font size (Mobile)",
      "min": 11,
      "max": 16,
      "step": 1,
      "unit": "px",
      "default": 13
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Body text color",
      "default": "#2b3b55"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Section background color",
      "default": "transparent"
    },
    {
      "type": "color",
      "id": "card_bg",
      "label": "Card background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "card_border_color",
      "label": "Card border color",
      "default": "#e6eaf0"
    },
    {
      "type": "range",
      "id": "card_radius",
      "label": "Card corner radius",
      "min": 0,
      "max": 32,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "range",
      "id": "trigger_padding_y_desktop",
      "label": "Vertical padding (Desktop)",
      "min": 14,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "trigger_padding_x_desktop",
      "label": "Horizontal padding (Desktop)",
      "min": 16,
      "max": 50,
      "step": 2,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "trigger_padding_y_mobile",
      "label": "Vertical padding (Mobile)",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 18
    },
    {
      "type": "range",
      "id": "trigger_padding_x_mobile",
      "label": "Horizontal padding (Mobile)",
      "min": 12,
      "max": 30,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "header",
      "content": "Container & Spacing"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container layout",
      "options": [
        { "value": "container", "label": "Default Container" },
        { "value": "1170", "label": "1170px Container" },
        { "value": "1770", "label": "1770px Container" },
        { "value": "fullwidth", "label": "Full Width" }
      ],
      "default": "container"
    },
    {
      "type": "range",
      "id": "padding_top_desktop",
      "label": "Padding Top (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_bottom_desktop",
      "label": "Padding Bottom (Desktop)",
      "min": 0,
      "max": 100,
      "step": 5,
      "unit": "px",
      "default": 35
    },
    {
      "type": "range",
      "id": "padding_side_desktop",
      "label": "Side Padding (Desktop)",
      "min": 0,
      "max": 120,
