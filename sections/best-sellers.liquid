  "tag": "section",
  "class": "section-best-sellers",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Products are pulled only from this collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 20,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "Product image ratio",
      "default": "portrait",
      "options": [
        { "value": "adapt", "label": "Adapt to image" },
        { "value": "portrait", "label": "Portrait" },
        { "value": "square", "label": "Square" }
      ]
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left",
      "label": "Left padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" },
        { "value": "60", "label": "60px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right",
      "label": "Right padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" },
        { "value": "60", "label": "60px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left_mobile",
      "label": "Left padding (mobile)",
      "default": "15",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right_mobile",
      "label": "Right padding (mobile)",
