        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" }
