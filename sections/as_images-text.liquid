<style>
    .row{
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        justify-content: center;

    }
    .d-flex{
        display: flex;
    }
    .col-6{
        width: 50% !important;
    }
    .container{
        max-width: 1490px;
        padding-left: 15px;
        padding-right: 15px;
    }
    .border{
        border: 3px solid #eff1fe;
    }
    .reverse{
        width: 100%;
        display: flex;
        flex-direction: row-reverse !important;
    }
    .as_img{
        width: 100%;
        height: 100%;
        object-fit: cover;
    }
    .as-pading{
        padding: 15px 25px;
    }
    .pera-text{
        text-align: center;
    }
    .pera-text h3{
        font-size: 25px;
        font-weight: 800;
    }
    .pera-text p{
        font-size: 16px;
    }
    .as-py50{
        padding-top: 50px;
        padding-bottom: 50px;
    }

  @media screen and (max-width: 850px){
    .col-6{
      width: 100% !important;
    }
  }
</style>

<section>
  <div class="container as-py50">
    <div>
      {%- for block in section.blocks -%}
        <div
          class="row border"
          {%- if block.settings.check_revs -%}
            style="                        flex-direction: row-reverse;"
          {%- endif -%}
        >
          <div class="col-6 as-pading pera-text">
            <h3>{{ block.settings['heading-text'] }}</h3>
            <p>{{ block.settings.pera }}</p>
          </div>
          <div class="col-6">
            <img class="as_img" src="{{ block.settings.imgs | img_url: 'master'  }}" alt="">
          </div>
          {% comment %} <span>{{ block.settings.check_revs }}</span> {% endcomment %}
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
"name": "AS Images with text",
"tag": "section",
"settings": [],
"blocks": [
    {
        "type": "add_blocks",
        "name": "add blocks",
        "settings": [
            {
                "type": "image_picker",
                "id": "imgs",
                "label": "Images"
            },
            {
                "type": "textarea",
                "id": "heading-text",
                "label": "Heading",
                "placeholder": "Enter Heading"
            },
            {
                "type": "textarea",
                "id": "pera",
                "label": "Sub Heading",
                "placeholder": "Enter Sub Heading"
            },
            {
                "type": "checkbox",
                "id": "check_revs",
                "label": "Reverse Images section"
            }
        ]
    }
],
"presets": [
{
"name": "AS Images with text",
"settings": {
}
}
]
}
{% endschema %}
