<style>
    .d-flex{
        display: flex;
    }
    .swiper {
      width: 100%;
      height: 100%;
    }

    .swiper-slide {
      text-align: center;
      font-size: 18px;
      background: #fff;
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 50px;
    }

    .swiper-slide img {
      display: block;
      width: 100%;
      height: 100%;
      object-fit: cover;
    }
    .col-4{
        width: 30%;
        text-align: start;
    }
    .col-8{
        width: 70%;
        text-align: start;
    }
    h3, .h3 {
        font-size: 25px;
        margin-bottom: -7px;
        font-weight: 600;
    }
    svg {
    width: 18px;
    height: 18px;
}

  @media only screen and (max-width: 600px){
    .swiper-slide{
      flex-wrap: wrap;
      gap: 25px;
    }
  }
</style>
<section>
