<link rel="stylesheet" href="{{ 'section-shop-by-health-need.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-shop-by-health-need.css' | asset_url | stylesheet_tag }}</noscript>
<script src="{{ 'as-shop-health-slider.js' | asset_url }}" defer></script>

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign show_subheading_mobile = section.settings.show_subheading_mobile
  assign show_view_all = section.settings.show_view_all
  assign view_all_label = section.settings.view_all_label
  assign view_all_label_mobile = section.settings.view_all_label_mobile
  if view_all_label_mobile == blank
    assign view_all_label_mobile = view_all_label
  endif
  assign view_all_link = section.settings.view_all_link
  if view_all_link == blank
    assign view_all_link = routes.collections_url
  endif
  assign show_view_all_arrow = section.settings.show_view_all_arrow

  assign container_class = 'container'
  if section.settings.container == 'fullwidth'
    assign container_class = 'container-full'
  elsif section.settings.container == '1170'
    assign container_class = 'container-1170'
  elsif section.settings.container == '1770'
    assign container_class = 'container-1770'
  endif

  assign default_columns_desktop = section.settings.columns_desktop | default: 3
  assign default_columns_tablet = section.settings.columns_tablet | default: 3
  assign default_columns_mobile = section.settings.columns_mobile | default: 2
  assign default_products = section.settings.products_to_show | default: 8
  assign image_ratio = section.settings.image_ratio
  if image_ratio == blank
    assign image_ratio = settings.product_block_image_ratio
  endif
  assign banner_media_style = section.settings.banner_media_style | default: 'full'
  assign show_arrows = section.settings.show_arrows
  assign show_arrows_mobile = section.settings.show_arrows_mobile
  assign show_dots = section.settings.show_dots
-%}

{% style %}
  #shopify-section-{{ section.id }} .shop-health {
    --sh-heading-color: {{ section.settings.heading_color }};
    --sh-subheading-color: {{ section.settings.subheading_color }};
    --sh-view-all-color: {{ section.settings.view_all_color }};
    --sh-view-all-hover-color: {{ section.settings.view_all_hover_color }};
    --sh-heading-size: {{ section.settings.heading_font_size }}px;
    --sh-heading-weight: {{ section.settings.heading_font_weight }};
    --sh-subheading-size: {{ section.settings.subheading_font_size }}px;
    --sh-view-all-size: {{ section.settings.view_all_font_size }}px;
    --sh-header-mb: {{ section.settings.header_margin_bottom }}px;
    --sh-row-gap: {{ section.settings.row_gap }}px;
    --sh-row-gap-mobile: {{ section.settings.row_gap_mobile }}px;
    --sh-banner-width: {{ section.settings.banner_width_desktop }}%;
    --sh-banner-width-mobile: {{ section.settings.banner_width_mobile }}%;
    --sh-banner-radius: {{ section.settings.banner_radius }}px;
    --sh-banner-height: {{ section.settings.banner_min_height }}px;
    --sh-banner-height-mobile: {{ section.settings.banner_min_height_mobile }}px;
    --sh-banner-padding: {{ section.settings.banner_padding }}px;
    --sh-banner-title-size: {{ section.settings.banner_title_size }}px;
    --sh-banner-title-size-mobile: {{ section.settings.banner_title_size_mobile }}px;
    --sh-banner-title-weight: {{ section.settings.banner_title_weight }};
    --sh-banner-media-width: {{ section.settings.banner_media_width }}%;
    --sh-banner-media-width-mobile: {{ section.settings.banner_media_width_mobile }}%;
    --sh-banner-media-inset: {{ section.settings.banner_media_inset }}px;
    --sh-product-gap: {{ section.settings.product_gap }}px;
    --sh-product-gap-mobile: {{ section.settings.product_gap_mobile }}px;
    --sh-columns-desktop: {{ default_columns_desktop }};
    --sh-columns-tablet: {{ default_columns_tablet }};
    --sh-columns-mobile: {{ default_columns_mobile }};
    --sh-shop-all-bg: {{ section.settings.shop_all_bg }};
    --sh-shop-all-color: {{ section.settings.shop_all_color }};
    --sh-shop-all-radius: {{ section.settings.shop_all_radius }}px;
    --sh-shop-all-size: {{ section.settings.shop_all_font_size }}px;
    --sh-shop-all-size-mobile: {{ section.settings.shop_all_font_size_mobile | default: 12 }}px;
    --sh-shop-all-padding-x-mobile: {{ section.settings.shop_all_padding_x_mobile | default: 18 }}px;
    --sh-shop-all-padding-y-mobile: {{ section.settings.shop_all_padding_y_mobile | default: 8 }}px;
    --sh-shop-all-min-height-mobile: {{ section.settings.shop_all_min_height_mobile | default: 36 }}px;
    --sh-shop-all-align-mobile: {{ section.settings.shop_all_alignment_mobile | default: 'flex-start' }};
    --sh-arrow-color: {{ section.settings.arrow_color }};
    --sh-arrow-bg: {{ section.settings.arrow_background }};
    --sh-arrow-border: {{ section.settings.arrow_border_color }};
    --sh-arrow-color-hover: {% if section.settings.arrow_color_hover != blank %}{{ section.settings.arrow_color_hover }}{% else %}{{ section.settings.arrow_color }}{% endif %};
    --sh-arrow-bg-hover: {% if section.settings.arrow_background_hover != blank %}{{ section.settings.arrow_background_hover }}{% else %}{{ section.settings.arrow_background }}{% endif %};
    --sh-arrow-border-hover: {% if section.settings.arrow_border_color_hover != blank %}{{ section.settings.arrow_border_color_hover }}{% else %}{{ section.settings.arrow_border_color }}{% endif %};
    --sh-arrow-size: {{ section.settings.arrow_size | default: 40 }}px;
    --sh-dots-color: {{ section.settings.dots_color }};
    --sh-dots-active: {{ section.settings.dots_active_color }};
    background: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{{ section.settings.background_color }}{% endif %};
    padding-top: {{ section.settings.padding_top_mobile }}px;
    padding-bottom: {{ section.settings.padding_bottom_mobile }}px;
  }

  #shopify-section-{{ section.id }} .shop-health .{{ container_class }} {
    padding-left: {{ section.settings.container_padding_left_mobile }}px !important;
    padding-right: {{ section.settings.container_padding_right_mobile }}px !important;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .shop-health__banner--full-media .shop-health__shop-all,
    #shopify-section-{{ section.id }} .shop-health__shop-all {
      align-self: var(--sh-shop-all-align-mobile);
      box-sizing: border-box;
      max-width: 100%;
      min-height: var(--sh-shop-all-min-height-mobile);
      padding: var(--sh-shop-all-padding-y-mobile) var(--sh-shop-all-padding-x-mobile);
      font-size: var(--sh-shop-all-size-mobile);
      line-height: 1.2;
      white-space: nowrap;
      margin-inline: 0;
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .shop-health .{{ container_class }} {
      padding-left: {{ section.settings.container_padding_left }}px !important;
      padding-right: {{ section.settings.container_padding_right }}px !important;
    }
    #shopify-section-{{ section.id }} .shop-health {
      padding-top: {{ section.settings.padding_top_tablet }}px;
      padding-bottom: {{ section.settings.padding_bottom_tablet }}px;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .shop-health {
      padding-top: {{ section.settings.padding_top_desktop }}px;
      padding-bottom: {{ section.settings.padding_bottom_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .shop-health {
      --sh-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --sh-subheading-size: {{ section.settings.subheading_font_size_mobile }}px;
      --sh-header-mb: {{ section.settings.header_margin_bottom_mobile }}px;
    }
  }
{% endstyle %}

<div
  class="shop-health section-block-{{ section.id }}{% if banner_media_style == 'full' %} shop-health--banner-full{% endif %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
  id="shop-health-{{ section.id }}"
>
  <div class="{{ container_class }}">
    <div class="shop-health__inner">
      {%- if heading != blank or subheading != blank or show_view_all -%}
        <div class="shop-health__header">
          <div class="shop-health__heading-group">
            {%- if heading != blank -%}
              <h2 class="shop-health__heading">{{ heading }}</h2>
            {%- endif -%}
            {%- if subheading != blank -%}
              <p class="shop-health__subheading{% unless show_subheading_mobile %} shop-health__subheading--hide-mobile{% endunless %}">
                {{ subheading }}
              </p>
            {%- endif -%}
          </div>
          {%- if show_view_all and view_all_label != blank -%}
            <a class="shop-health__view-all" href="{{ view_all_link }}">
              <span class="shop-health__view-all-label shop-health__view-all-label--desktop">{{ view_all_label }}</span>
              <span class="shop-health__view-all-label shop-health__view-all-label--mobile">{{ view_all_label_mobile }}</span>
              {%- if show_view_all_arrow -%}
                <span class="icon-arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                    <path d="M2 8h10M8.5 3.5L13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <ul class="shop-health__rows" role="list">
          {%- for block in section.blocks -%}
            {%- liquid
              assign collection = block.settings.collection
              assign card_title = block.settings.title
              if card_title == blank and collection != blank
                assign card_title = collection.title
              endif
              if card_title == blank
                assign card_title = 'Collection'
              endif

              assign shop_all_label = block.settings.shop_all_label
              if shop_all_label == blank
                assign shop_all_label = section.settings.shop_all_label | default: 'Shop all'
              endif

              assign shop_all_link = block.settings.link
              if shop_all_link == blank and collection != blank
                assign shop_all_link = collection.url
              endif

              assign banner_image = block.settings.image
              if banner_image == blank and collection != blank and collection.featured_image
                assign banner_image = collection.featured_image
              endif

              assign banner_bg = block.settings.background_color
              if banner_bg == blank
                assign banner_bg = section.settings.banner_bg_fallback
              endif
              assign banner_accent = block.settings.accent_color
              if banner_accent == blank
                assign banner_accent = section.settings.banner_accent_fallback
              endif
              assign title_color = block.settings.title_color
              if title_color == blank
                assign title_color = section.settings.banner_title_color
              endif

              assign layout_desktop = block.settings.layout_desktop
              if layout_desktop == blank or layout_desktop == 'default'
                assign layout_desktop = section.settings.default_layout_desktop | default: 'carousel'
              endif
              assign layout_mobile = block.settings.layout_mobile
              if layout_mobile == blank or layout_mobile == 'default'
                assign layout_mobile = section.settings.default_layout_mobile | default: 'carousel'
              endif

              assign products_limit = block.settings.products_to_show | plus: 0
              if products_limit == 0
                assign products_limit = default_products | plus: 0
              endif
              if products_limit < 1
                assign products_limit = 8
              endif

              assign cols_desktop = block.settings.columns_desktop | plus: 0
              assign cols_tablet = block.settings.columns_tablet | plus: 0
              assign cols_mobile = block.settings.columns_mobile | plus: 0
              if cols_desktop == 0
                assign cols_desktop = default_columns_desktop | plus: 0
              endif
              if cols_tablet == 0
                assign cols_tablet = default_columns_tablet | plus: 0
              endif
              if cols_mobile == 0
                assign cols_mobile = default_columns_mobile | plus: 0
              endif

              assign row_banner_width = section.settings.banner_width_desktop | default: 32 | plus: 0
              assign row_banner_width_mobile = section.settings.banner_width_mobile | default: 100 | plus: 0
              assign row_banner_height = section.settings.banner_min_height | default: 480 | plus: 0
              assign row_banner_height_mobile = section.settings.banner_min_height_mobile | default: 220 | plus: 0
              if row_banner_width == 0
                assign row_banner_width = 32
              endif
              if row_banner_width_mobile == 0
                assign row_banner_width_mobile = 100
              endif
              if row_banner_height == 0
                assign row_banner_height = 480
              endif
              if row_banner_height_mobile == 0
                assign row_banner_height_mobile = 220
              endif

              assign block_banner_width = block.settings.banner_width | plus: 0
              assign block_banner_width_mobile = block.settings.banner_width_mobile | plus: 0
              assign block_banner_height = block.settings.banner_min_height | plus: 0
              assign block_banner_height_mobile = block.settings.banner_min_height_mobile | plus: 0

              if block_banner_width > 0
                assign row_banner_width = block_banner_width
              endif
              if block_banner_width_mobile > 0
                assign row_banner_width_mobile = block_banner_width_mobile
              endif
              if block_banner_height > 0
                assign row_banner_height = block_banner_height
              endif
              if block_banner_height_mobile > 0
                assign row_banner_height_mobile = block_banner_height_mobile
              endif
            -%}
            <li
              id="shop-health-block-{{ block.id }}"
              class="shop-health__row shop-health__row--desktop-{{ layout_desktop }} shop-health__row--mobile-{{ layout_mobile }}"
              style="
                --sh-banner-bg: {{ banner_bg }};
                --sh-banner-accent: {{ banner_accent }};
                --sh-banner-title-color: {{ title_color }};
                --sh-banner-width: {{ row_banner_width }}%;
                --sh-banner-width-mobile: {{ row_banner_width_mobile }}%;
                --sh-banner-height: {{ row_banner_height }}px;
                --sh-banner-height-mobile: {{ row_banner_height_mobile }}px;
                --sh-columns-desktop: {{ cols_desktop }};
                --sh-columns-tablet: {{ cols_tablet }};
                --sh-columns-mobile: {{ cols_mobile }};
              "
              {{ block.shopify_attributes }}
            >
              <a
                class="shop-health__banner{% if banner_media_style == 'full' %} shop-health__banner--full-media{% else %} shop-health__banner--inset-media{% endif %}"
                {% if shop_all_link != blank %}href="{{ shop_all_link }}"{% else %}role="link" aria-disabled="true"{% endif %}
                aria-label="{{ card_title | escape }} — {{ shop_all_label | escape }}"
              >
                <div class="shop-health__banner-media">
                  {%- if banner_image != blank -%}
                    {{
                      banner_image
                      | image_url: width: 1200
                      | image_tag:
                        loading: 'lazy',
                        widths: '320, 480, 640, 800, 1000, 1200',
                        sizes: '(max-width: 989px) 100vw, 35vw',
                        alt: card_title
                    }}
                  {%- else -%}
                    {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  {%- endif -%}
                </div>
                <h3 class="shop-health__banner-title" style="color: {{ title_color }};">{{ card_title }}</h3>
                <span class="shop-health__shop-all">{{ shop_all_label }}</span>
              </a>

              <div class="shop-health__products">
                {%- comment -%} Desktop carousel / Mobile carousel {%- endcomment -%}
                {%- if layout_desktop == 'carousel' or layout_mobile == 'carousel' -%}
                  <shop-health-slider
                    class="shop-health__slider-wrap shop-health__display--carousel{% if layout_desktop == 'grid' %} shop-health__display--desktop-hide{% endif %}{% if layout_mobile == 'grid' %} shop-health__display--mobile-hide{% endif %}{% if show_arrows and show_arrows_mobile %} shop-health__slider-wrap--arrows-mobile{% endif %}"
                    data-columns-desktop="{{ cols_desktop }}"
                    data-columns-tablet="{{ cols_tablet }}"
                    data-columns-mobile="{{ cols_mobile }}"
                  >
                    <div class="shop-health__track" data-sh-track>
                      {%- if collection != blank and collection.products.size > 0 -%}
                        {%- for product in collection.products limit: products_limit -%}
                          <div class="shop-health__slide" data-sh-slide>
                            {% render 'product-grid-layout',
                              product_card_product: product,
                              portrait_aspect_ratio: '125',
                              serial: forloop.index,
                              sectionId: section.id,
                              media_size: image_ratio,
                              loading: true
                            %}
                          </div>
                        {%- endfor -%}
                      {%- else -%}
                        {%- for i in (1..products_limit) -%}
                          <div class="shop-health__slide" data-sh-slide>
                            {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                            {% render 'product-card-placeholder', index: current %}
                          </div>
                        {%- endfor -%}
                      {%- endif -%}
                    </div>

                    {%- if show_arrows -%}
                      <button type="button" class="shop-health__arrow shop-health__arrow--prev is-disabled" data-sh-prev aria-label="Previous products" disabled aria-disabled="true">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                          <path d="M10.5 2.5L5 8l5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                      <button type="button" class="shop-health__arrow shop-health__arrow--next" data-sh-next aria-label="Next products">
                        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                          <path d="M5.5 2.5L11 8l-5.5 5.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                      </button>
                    {%- endif -%}

                    {%- if show_dots -%}
                      <div class="shop-health__dots" data-sh-dots role="tablist" aria-label="{{ card_title | escape }} products"></div>
                    {%- endif -%}
                  </shop-health-slider>
                {%- endif -%}

                {%- if layout_desktop == 'grid' or layout_mobile == 'grid' -%}
                  <div
                    class="shop-health__grid shop-health__display--grid{% if layout_desktop == 'carousel' %} shop-health__display--desktop-hide{% endif %}{% if layout_mobile == 'carousel' %} shop-health__display--mobile-hide{% endif %}"
                    style="--sh-columns-desktop: {{ cols_desktop }}; --sh-columns-tablet: {{ cols_tablet }}; --sh-columns-mobile: {{ cols_mobile }};"
                  >
                    {%- if collection != blank and collection.products.size > 0 -%}
                      {%- for product in collection.products limit: products_limit -%}
                        <div class="shop-health__grid-item">
                          {% render 'product-grid-layout',
                            product_card_product: product,
                            portrait_aspect_ratio: '125',
                            serial: forloop.index,
                            sectionId: section.id,
                            media_size: image_ratio,
                            loading: true
                          %}
                        </div>
                      {%- endfor -%}
                    {%- else -%}
                      {%- for i in (1..products_limit) -%}
                        <div class="shop-health__grid-item">
                          {% capture current %}{% cycle 1, 2, 3, 4, 5, 6 %}{% endcapture %}
                          {% render 'product-card-placeholder', index: current %}
                        </div>
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                {%- endif -%}
              </div>
            </li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  /* Show/hide grid vs carousel by breakpoint without duplicating wrong layout */
  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .shop-health__display--desktop-hide {
      display: none !important;
    }
  }
  @media screen and (max-width: 989px) {
    #shopify-section-{{ section.id }} .shop-health__display--mobile-hide {
      display: none !important;
    }
  }
</style>

{% schema %}
{
  "name": "AS Shop By Health Need",
  "tag": "section",
  "class": "section-shop-by-health-need",
  "max_blocks": 12,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left",
      "label": "Left padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "30", "label": "30px" },
        { "value": "50", "label": "50px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right",
      "label": "Right padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "30", "label": "30px" },
        { "value": "50", "label": "50px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left_mobile",
      "label": "Left padding (mobile)",
      "default": "15",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right_mobile",
      "label": "Right padding (mobile)",
      "default": "15",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" }
      ]
    },
    {
      "type": "range",
      "id": "row_gap",
      "label": "Space between categories (desktop)",
      "min": 16,
      "max": 80,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "row_gap_mobile",
      "label": "Space between categories (mobile)",
      "min": 12,
      "max": 60,
      "step": 4,
      "unit": "px",
      "default": 28
    },
    {
      "type": "header",
      "content": "Products — defaults"
    },
    {
      "type": "paragraph",
      "content": "Defaults for each category. Individual blocks can override layout, columns, and product count."
    },
    {
      "type": "select",
      "id": "default_layout_desktop",
      "label": "Default product layout (desktop)",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "select",
      "id": "default_layout_mobile",
      "label": "Default product layout (mobile)",
      "default": "carousel",
      "options": [
        { "value": "carousel", "label": "Carousel" },
        { "value": "grid", "label": "Grid" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
      "label": "Default columns (desktop)",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 3
    },
    {
