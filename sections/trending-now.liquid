<link rel="stylesheet" href="{{ 'section-trending-now.css' | asset_url }}" media="print" onload="this.media='all'">
<noscript>{{ 'section-trending-now.css' | asset_url | stylesheet_tag }}</noscript>

{%- liquid
  assign heading = section.settings.heading
  assign subheading = section.settings.subheading
  assign view_all_label = section.settings.view_all_label
  assign view_all_label_mobile = section.settings.view_all_label_mobile
  if view_all_label_mobile == blank
    assign view_all_label_mobile = view_all_label
  endif
  assign view_all_link = section.settings.view_all_link
  if view_all_link == blank
    assign view_all_link = routes.collections_url
  endif
  assign show_view_all = section.settings.show_view_all
  assign show_view_all_arrow = section.settings.show_view_all_arrow
  assign header_alignment = section.settings.header_alignment
  assign mobile_layout = section.settings.mobile_layout
  assign show_subheading_mobile = section.settings.show_subheading_mobile

  assign container_class = 'container'
  if section.settings.container == 'fullwidth'
    assign container_class = 'container-full'
  elsif section.settings.container == '1170'
    assign container_class = 'container-1170'
  elsif section.settings.container == '1770'
    assign container_class = 'container-1770'
  endif
-%}

{%- liquid
  assign columns_desktop = section.settings.columns_desktop
  assign columns_tablet = section.settings.columns_tablet
  assign columns_mobile = section.settings.columns_mobile
-%}
{% style %}
  #shopify-section-{{ section.id }} .trending-now {
    --tn-heading-color: {{ section.settings.heading_color }};
    --tn-subheading-color: {{ section.settings.subheading_color }};
    --tn-label-color: {{ section.settings.label_color }};
    --tn-view-all-color: {{ section.settings.view_all_color }};
    --tn-view-all-hover-color: {{ section.settings.view_all_hover_color }};
    --tn-icon-bg: {{ section.settings.icon_bg_color }};
    --tn-icon-size: {{ section.settings.icon_size_desktop }}px;
    --tn-item-gap: {{ section.settings.item_gap_desktop }}px;
    --tn-label-size: {{ section.settings.label_font_size }}px;
    --tn-label-weight: {{ section.settings.label_font_weight }};
    --tn-label-mt: {{ section.settings.label_margin_top }}px;
    --tn-heading-size: {{ section.settings.heading_font_size }}px;
    --tn-heading-weight: {{ section.settings.heading_font_weight }};
    --tn-subheading-size: {{ section.settings.subheading_font_size }}px;
    --tn-view-all-size: {{ section.settings.view_all_font_size }}px;
    --tn-header-mb: {{ section.settings.header_margin_bottom }}px;
    --tn-columns-desktop: {{ columns_desktop }};
    --tn-columns-tablet: {{ columns_tablet }};
    --tn-columns-mobile: {{ columns_mobile }};
    --tn-scroll-item-width: {{ section.settings.scroll_item_width }}px;
    --tn-pad-t: {{ section.settings.padding_top_mobile }}px;
    --tn-pad-b: {{ section.settings.padding_bottom_mobile }}px;
    --tn-container-pad-l: {{ section.settings.container_padding_left_mobile }}px;
    --tn-container-pad-r: {{ section.settings.container_padding_right_mobile }}px;
    background: {% if section.settings.background_gradient != blank %}{{ section.settings.background_gradient }}{% else %}{{ section.settings.background_color }}{% endif %};
    padding-top: var(--tn-pad-t) !important;
    padding-bottom: var(--tn-pad-b) !important;
  }

  #shopify-section-{{ section.id }} .trending-now .{{ container_class }} {
    padding-left: var(--tn-container-pad-l) !important;
    padding-right: var(--tn-container-pad-r) !important;
    overflow: visible;
  }

  /* Tablet: 750px – 1024px (matches Halo theme) */
  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .trending-now {
      --tn-pad-t: {{ section.settings.padding_top_tablet }}px;
      --tn-pad-b: {{ section.settings.padding_bottom_tablet }}px;
      --tn-container-pad-l: {{ section.settings.container_padding_left }}px;
      --tn-container-pad-r: {{ section.settings.container_padding_right }}px;
    }
  }

  /* Desktop: 1025px+ */
  @media screen and (min-width: 1025px) {
    #shopify-section-{{ section.id }} .trending-now {
      --tn-pad-t: {{ section.settings.padding_top_desktop }}px;
      --tn-pad-b: {{ section.settings.padding_bottom_desktop }}px;
      --tn-heading-size: {{ section.settings.heading_font_size }}px;
      --tn-subheading-size: {{ section.settings.subheading_font_size }}px;
      --tn-label-size: {{ section.settings.label_font_size }}px;
      --tn-view-all-size: {{ section.settings.view_all_font_size }}px;
      --tn-icon-size: {{ section.settings.icon_size_desktop }}px;
      --tn-item-gap: {{ section.settings.item_gap_desktop }}px;
      --tn-header-mb: {{ section.settings.header_margin_bottom }}px;
    }
  }

  /* Mobile only: apply mobile typography / icon / gap settings */
  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .trending-now {
      --tn-heading-size: {{ section.settings.heading_font_size_mobile }}px;
      --tn-subheading-size: {{ section.settings.subheading_font_size_mobile }}px;
      --tn-label-size: {{ section.settings.label_font_size_mobile }}px;
      --tn-view-all-size: {{ section.settings.view_all_font_size_mobile }}px;
      --tn-icon-size: {{ section.settings.icon_size_mobile }}px;
      --tn-item-gap: {{ section.settings.item_gap_mobile }}px;
      --tn-header-mb: {{ section.settings.header_margin_bottom_mobile }}px;
    }
  }

  /* Icon size — section-scoped so Theme Editor slider always wins */
  #shopify-section-{{ section.id }} .trending-now__media {
    width: var(--tn-icon-size);
    height: var(--tn-icon-size);
    min-width: var(--tn-icon-size);
    min-height: var(--tn-icon-size);
    max-width: var(--tn-icon-size);
    background: transparent;
  }

  #shopify-section-{{ section.id }} .trending-now__item {
    width: 100%;
    min-width: 0;
    max-width: none;
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .trending-now__list--mobile-scroll .trending-now__item {
      width: var(--tn-scroll-item-width);
      min-width: var(--tn-scroll-item-width);
    }
  }
{% endstyle %}

<div
  class="trending-now section-block-{{ section.id }}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
  id="trending-now-{{ section.id }}"
>
  <div class="{{ container_class }}">
    <div class="trending-now__inner">
      {%- if heading != blank or subheading != blank or show_view_all -%}
        <div class="trending-now__header trending-now__header--{{ header_alignment }}">
          <div class="trending-now__heading-group">
            {%- if heading != blank -%}
              <h2 class="trending-now__heading">{{ heading }}</h2>
            {%- endif -%}
            {%- if subheading != blank -%}
              <p class="trending-now__subheading{% unless show_subheading_mobile %} trending-now__subheading--hide-mobile{% endunless %}">
                {{ subheading }}
              </p>
            {%- endif -%}
          </div>

          {%- if show_view_all and view_all_label != blank -%}
            <a class="trending-now__view-all" href="{{ view_all_link }}">
              <span class="trending-now__view-all-label trending-now__view-all-label--desktop">{{ view_all_label }}</span>
              <span class="trending-now__view-all-label trending-now__view-all-label--mobile">{{ view_all_label_mobile }}</span>
              {%- if show_view_all_arrow -%}
                <span class="icon-arrow" aria-hidden="true">
                  <svg viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg" focusable="false">
                    <path d="M2 8h10M8.5 3.5L13 8l-4.5 4.5" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </span>
              {%- endif -%}
            </a>
          {%- endif -%}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="trending-now__row">
          <ul
            class="trending-now__list{% if mobile_layout == 'grid' %} trending-now__list--mobile-grid{% else %} trending-now__list--mobile-scroll{% endif %}"
            role="list"
          >
            {%- for block in section.blocks -%}
              {%- liquid
                assign collection = block.settings.collection
                assign item_title = block.settings.title
                if item_title == blank and collection != blank
                  assign item_title = collection.title
                endif
                if item_title == blank
                  assign item_title = 'Collection'
                endif

                assign item_link = block.settings.link
                if item_link == blank and collection != blank
                  assign item_link = collection.url
                endif

                assign item_image = block.settings.image
                if item_image == blank and collection != blank and collection.featured_image
                  assign item_image = collection.featured_image
                endif
                if item_image == blank and collection != blank and collection.products.first and collection.products.first.featured_media
                  assign item_image = collection.products.first.featured_media.preview_image
                endif
              -%}
              <li
                class="trending-now__item{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                {{ block.shopify_attributes }}
                {% if settings.banner_animation == 'effect_fade_up' %}style="--animation-order: {{ forloop.index }};"{% endif %}
              >
                <a
                  class="trending-now__link"
                  {% if item_link != blank %}
                    href="{{ item_link }}"
                  {% else %}
                    role="link"
                    aria-disabled="true"
                  {% endif %}
                  {% if item_title != blank %}
                    aria-label="{{ item_title | escape }}"
                  {% endif %}
                >
                  <div class="trending-now__media">
                    {%- if item_image != blank -%}
                      {{
                        item_image
                        | image_url: width: 300
                        | image_tag:
                          loading: 'lazy',
                          widths: '120, 160, 200, 240, 300',
                          sizes: '(max-width: 989px) 72px, 110px',
                          alt: item_title
                      }}
                    {%- else -%}
                      {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
                    {%- endif -%}
                  </div>
                  {%- if item_title != blank -%}
                    <span class="trending-now__label">{{ item_title | replace: ' & ', ' &<br>' | newline_to_br }}</span>
                  {%- endif -%}
                </a>
              </li>
            {%- endfor -%}
          </ul>
        </div>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "AS Trending Now",
  "tag": "section",
  "class": "section-trending-now",
  "max_blocks": 16,
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "container",
      "label": "Container",
      "default": "container",
      "options": [
        { "value": "container", "label": "Default" },
        { "value": "1170", "label": "1170px" },
        { "value": "1770", "label": "1770px" },
        { "value": "fullwidth", "label": "Full width" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left",
      "label": "Left padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" },
        { "value": "60", "label": "60px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right",
      "label": "Right padding (desktop)",
      "default": "50",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" },
        { "value": "60", "label": "60px" },
        { "value": "80", "label": "80px" },
        { "value": "100", "label": "100px" },
        { "value": "120", "label": "120px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_left_mobile",
      "label": "Left padding (mobile)",
      "default": "15",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" }
      ]
    },
    {
      "type": "select",
      "id": "container_padding_right_mobile",
      "label": "Right padding (mobile)",
      "default": "15",
      "options": [
        { "value": "0", "label": "0px" },
        { "value": "10", "label": "10px" },
        { "value": "15", "label": "15px" },
        { "value": "20", "label": "20px" },
        { "value": "24", "label": "24px" },
        { "value": "30", "label": "30px" },
        { "value": "40", "label": "40px" },
        { "value": "50", "label": "50px" }
      ]
    },
    {
      "type": "select",
      "id": "header_alignment",
      "label": "Header alignment",
      "default": "left",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ]
    },
    {
      "type": "range",
      "id": "columns_desktop",
