        {
            "type": "checkbox",
            "id": "main_image_arrows_mobile",
            "label": "t:sections.main-product.settings.general.main_image_arrows_mobile",
            "default": true
        },
        {
            "type": "header",
            "content": "Product image arrows style"
        },
        {
            "type": "select",
            "id": "arrow_layout",
            "label": "Arrow layout",
            "default": "square",
            "options": [
                {
                    "value": "square",
                    "label": "Square"
                },
                {
                    "value": "circle",
                    "label": "Circle"
                },
                {
                    "value": "minimal",
                    "label": "Minimal (icon only)"
                }
            ]
        },
        {
            "type": "color",
            "id": "arrow_bg_color",
            "label": "Arrow background",
            "default": "#ffffff"
        },
        {
            "type": "range",
            "id": "arrow_bg_opacity",
            "label": "Arrow background opacity",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "%",
            "default": 85
        },
        {
            "type": "color",
            "id": "arrow_icon_color",
            "label": "Arrow icon color",
            "default": "#111111"
        },
        {
            "type": "range",
            "id": "arrow_border_radius",
            "label": "Arrow corner radius",
            "min": 0,
            "max": 20,
            "step": 1,
            "unit": "px",
            "default": 4,
            "info": "Used for Square layout only."
        },
        {
            "type": "range",
            "id": "arrow_size_desktop",
            "label": "Arrow size (desktop)",
            "min": 24,
            "max": 56,
            "step": 2,
            "unit": "px",
            "default": 36
        },
        {
            "type": "range",
            "id": "arrow_size_mobile",
            "label": "Arrow size (mobile)",
            "min": 24,
            "max": 48,
            "step": 2,
            "unit": "px",
            "default": 32
        },
        {
            "type": "range",
            "id": "arrow_offset_desktop",
            "label": "Arrow side offset (desktop)",
            "min": 0,
            "max": 40,
            "step": 2,
            "unit": "px",
            "default": 10
        },
        {
            "type": "range",
            "id": "arrow_offset_mobile",
            "label": "Arrow side offset (mobile)",
            "min": 0,
            "max": 30,
            "step": 2,
            "unit": "px",
            "default": 8
        },
        {
            "type": "checkbox",
            "id": "main_image_counter_mobile",
            "label": "t:sections.main-product.settings.general.main_image_counter_mobile",
            "info": "t:sections.main-product.settings.general.info_main_image_counter_mobile",
