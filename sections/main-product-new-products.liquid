{% comment %} Isolated layout for product.new-products template only {% endcomment %}
{% render 'product-page-new-products' %}

{% schema %}
{
    "name": "Product Information",
    "settings": [
        {
            "type": "header",
            "content": "t:settings_schema.general.name"
        },
        {
            "type": "select",
            "id": "container",
            "label": "t:sections.layout.container.option",
            "default": "container",
            "options": [
                {
                    "value": "container",
                    "label": "t:sections.layout.container.option1"
                },
                {
                    "value": "1170",
                    "label": "t:sections.layout.container.option4"
                },
                {
                    "value": "1470",
                    "label": "1470"
                },
                {
                    "value": "1770",
                    "label": "t:sections.layout.container.option3"
                },
                {
                    "value": "fullwidth",
                    "label": "t:sections.layout.container.option2"
                }
            ]
        },
        {
            "type": "range",
            "id": "padding_full_width",
            "label": "t:sections.layout.container.padding_full_width",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "t:sections.layout.fontsize.fontsize_title.unit",
            "default": 0,
            "info": "t:sections.layout.container.info_full_width"
        },
        {
            "type": "header",
            "content": "Section spacing (desktop)"
        },
        {
            "type": "paragraph",
            "content": "Left/right padding to match homepage sections (homepage uses 80px)."
        },
        {
            "type": "range",
            "id": "container_padding_left",
            "label": "Padding left",
            "min": 0,
            "max": 120,
            "step": 5,
            "unit": "px",
            "default": 80
        },
        {
            "type": "range",
            "id": "container_padding_right",
            "label": "Padding right",
            "min": 0,
            "max": 120,
            "step": 5,
            "unit": "px",
            "default": 80
        },
        {
            "type": "header",
            "content": "Section spacing (mobile)"
        },
        {
            "type": "range",
            "id": "container_padding_left_mobile",
            "label": "Padding left",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "range",
            "id": "container_padding_right_mobile",
            "label": "Padding right",
            "min": 0,
            "max": 50,
            "step": 1,
            "unit": "px",
            "default": 15
        },
        {
            "type": "checkbox",
            "id": "show_sticky_info",
            "label": "t:sections.main-product.settings.general.label__1",
            "default": true
        },
        {
            "type": "header",
            "content": "Section spacing"
        },
        {
            "type": "paragraph",
            "content": "Controls space above and below Product Information. Desktop ≥1025px, tablet 768–1024px, mobile ≤767px."
        },
        {
            "type": "range",
            "id": "mg_top_desktop",
            "label": "Top spacing (desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_top_tablet",
            "label": "Top spacing (tablet)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_top_mobile",
            "label": "Top spacing (mobile)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_bottom_desktop",
            "label": "Bottom spacing (desktop)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_bottom_tablet",
            "label": "Bottom spacing (tablet)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "range",
            "id": "mg_bottom_mobile",
            "label": "Bottom spacing (mobile)",
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "px",
            "default": 0
        },
        {
            "type": "header",
            "content": "t:sections.main-product.settings.general.main_image"
        },
        {
            "type": "checkbox",
            "id": "hide_main_image_arrows",
            "label": "Hide main image navigation arrows",
            "default": false,
            "info": "Hides the left and right navigation arrows on the large main product image."
        },
        {
            "type": "checkbox",
            "id": "main_image_arrows_desktop",
            "label": "t:sections.main-product.settings.general.main_image_arrows_desktop",
            "default": false
