    { "type": "range", "id": "tab_padding_x_mobile", "label": "Tab horizontal padding (mobile)", "min": 8, "max": 32, "step": 1, "unit": "px", "default": 12 },
    { "type": "range", "id": "tab_padding_y_mobile", "label": "Tab vertical padding (mobile)", "min": 4, "max": 20, "step": 1, "unit": "px", "default": 10 },
    { "type": "range", "id": "tab_font_size", "label": "Tab font size", "min": 12, "max": 24, "step": 1, "unit": "px", "default": 16 },
    { "type": "range", "id": "tab_font_size_mobile", "label": "Tab font size (mobile)", "min": 11, "max": 20, "step": 1, "unit": "px", "default": 14 },
    { "type": "select", "id": "tab_font_weight", "label": "Tab font weight", "default": "600", "options": [
