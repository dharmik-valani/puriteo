    { "type": "range", "id": "ingredient_gap_vertical", "label": "Ingredient vertical gap", "min": 0, "max": 60, "step": 2, "unit": "px", "default": 24 },
    { "type": "range", "id": "icon_size", "label": "Benefit icon size", "min": 32, "max": 140, "step": 2, "unit": "px", "default": 72 },
    { "type": "range", "id": "ingredient_icon_size", "label": "Ingredient icon size", "min": 40, "max": 180, "step": 2, "unit": "px", "default": 96 },
    { "type": "color", "id": "icon_background", "label": "Icon background", "default": "#dcefe2" },
