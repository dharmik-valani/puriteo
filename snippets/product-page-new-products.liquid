                                                assign meta_key = block.settings.product_tab_key_metafield
                                                if product.metafields.c_f[meta_key] != blank or product.metafields.custom[meta_key] != blank
                                                    assign has_tab_data = true
                                                endif
                                            else
                                                assign is_htu = false
                                                if block.settings.title contains 'How to' or block.settings.title contains 'how to' or block.settings.title contains 'How To' or block.settings.title contains 'how_to_use' or block.settings.content contains 'how_to_use'
                                                    assign is_htu = true
                                                endif

                                                assign is_static_content = false
                                                if tab_content_clean != blank
                                                    unless block.settings.content contains '{{'
                                                        assign is_static_content = true
                                                    endunless
                                                endif

