<div class="product-details product-full-width product-new-products{% if has_sidebar %} has-sidebar{% endif %}{% if mobile_layout == 'info_first' %} npp-mobile-info-first{% endif %}" data-section-id="{{ section.id }}" data-section-type="product" id="ProductSection-{{ section.id }}" data-has-combo="{{ has_product_combo }}" data-image-opo>
