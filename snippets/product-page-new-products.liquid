                                                --tab-border-bottom-width: {% if tab_border_bottom %}1px{% else %}0px{% endif %};
                                                --tab-content-size: {{ content_fontsize }}px;
                                                --tab-content-size-mb: {{ content_fontsize_mb }}px;
                                                --tab-content-line-height: {{ content_line_height }};
                                                --subtab-title-size: {{ subtab_title_fontsize }}px;
                                                --subtab-title-size-mb: {{ subtab_title_fontsize_mb }}px;"
                                                {{ block.shopify_attributes }}
                                            >
                                                {% render 'halo-product-collapse-tab',
                                                    product: product,
                                                    section: section,
                                                    tab_block: block,
                                                    tab_layout: 'vertical',
                                                    tab_layout_mobile: 'vertical',
                                                    icon_style_layout: 'style_1'
