                                                if kf_text_clean != blank
                                                    unless block.settings.key_features_text contains '{{'
                                                        assign is_static_kf = true
                                                    endunless
                                                endif

                                                assign is_static_hb = false
                                                if hb_text_clean != blank
                                                    unless block.settings.health_benefits_text contains '{{'
                                                        assign is_static_hb = true
                                                    endunless
                                                endif

