    window.selling_array_{{ product.id }} = {
        {% for variant in product.variants %}
            '{{ variant.id }}': '{{ variant.inventory_policy }}',
        {%endfor%}
    };
  
    window.subtotal = {
        show: {{ show_subtotal_text }},
        style: {{ subtotal_style }},
