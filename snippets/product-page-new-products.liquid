                                                    <div class="productView-thumbnail{% if forloop.first %} is-active slick-current{% endif %} {% if show_variant_image_group %} filter-{{ media.alt | escape | downcase | replace: ' ', '-' | replace: '(', '-' | replace: ')', '-' }}{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}" data-media="{{ media.id }}">
                                                        <a class="productView-thumbnail-link" href="javascript:void(0)" data-image="{{ media | img_url: 'large' }}" draggable="false" tabindex="0" role="button" aria-label="Thumbnail {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                                                             <img src="{%- if thumnail_layout == '3' -%}{{ media | img_url: 'large' }}{% else %}{{ media | img_url: 'medium' }}{% endif %}" alt="{{ media.alt | escape }}" title="{{ media.alt | escape }}" loading="lazy" draggable="false" />
                                                        </a>
                                                    </div>
                                                {%- when 'external_video' -%}
                                                    {%- if video_layout == 'thumbnail' -%}
                                                        <div class="productView-thumbnail{% if forloop.first %} is-active slick-current{% endif %} filter-{{ media.alt | escape | downcase | replace: ' ', '-' | replace: '(', '-' | replace: ')', '-' }}" data-media-id="{{ section.id }}-{{ media.id }}" data-media="{{ media.id }}">
                                                            <div class="productView-thumbnail-link" draggable="false" tabindex="0" role="button" aria-label="Video thumbnail {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                                                                <img src="{%- if thumnail_layout == '3' -%}{{ media | img_url: 'large' }}{% else %}{{ media | img_url: 'medium' }}{% endif %}" alt="{{ media.alt | escape }}" title="{{ media.alt | escape }}" loading="lazy" draggable="false" />
                                                            </div>
                                                            <div class="productView-thumbnail-icon">
                                                                {% render 'icon-video' %}
                                                            </div>
                                                        </div>
                                                    {%- endif -%}
                                                {%- when 'video' -%}
                                                    {%- if video_layout == 'thumbnail' -%}
                                                        <div class="productView-thumbnail{% if forloop.first %} is-active slick-current{% endif %} filter-{{ media.alt | escape | downcase | replace: ' ', '-' | replace: '(', '-' | replace: ')', '-' }}" data-media-id="{{ section.id }}-{{ media.id }}" data-media="{{ media.id }}">
                                                            <div class="productView-thumbnail-link" draggable="false" tabindex="0" role="button" aria-label="Video thumbnail {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                                                                <img src="{{ media | media_tag | split: 'src="' | last | split: '">' | first }}" alt="{{ media.alt | escape }}" title="{{ media.alt | escape }}" loading="lazy" draggable="false" />
                                                            </div>
                                                            <div class="productView-thumbnail-icon">
                                                                {% render 'icon-video' %}
                                                            </div>
                                                        </div>
                                                    {%- endif -%}
                                                {%- when 'model' -%}
                                                    <div class="productView-thumbnail{% if forloop.first %} is-active slick-current{% endif %}" data-media-id="{{ section.id }}-{{ media.id }}" data-media="{{ media.id }}">
                                                        <div class="productView-thumbnail-link" draggable="false" tabindex="0" role="button" aria-label="3D Model thumbnail {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                                                            <img src="{{ media | media_tag | split: 'poster="' | last | split: '">' | first }}" alt="{{ media.alt | escape }}" title="{{ media.alt | escape }}" loading="lazy" draggable="false" />
                                                        </div>
                                                        <div class="productView-thumbnail-icon">
                                                            {% render 'icon-3d-model' %}
                                                        </div>
                                                    </div>
                                                {%- else -%}
                                                    <div class="productView-thumbnail{% if forloop.first %} is-active slick-current{% endif %} filter-{{ media.alt | escape | downcase | replace: ' ', '-' | replace: '(', '-' | replace: ')', '-' }}" data-media-id="{{ section.id }}-{{ media.id }}">
                                                        <div class="productView-thumbnail-link" tabindex="0" role="button" aria-label="Media thumbnail {{ forloop.index }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                                                            {{ media | media_tag }}
                                                        </div>
                                                    </div>
                                            {%- endcase -%}
                                        {%- endfor -%}
                                    </div>
                                    <button type="button" class="productView-thumb-arrow productView-thumb-arrow--next" aria-label="Next thumbnails" tabindex="-1">
                                        {% render 'icon-chevron-right' %}
                                    </button>
                                </div>
                            {%- endif -%}
                        </div>
                    </div>
                    <div class="halo-productView-right productView-details clearfix">
                        <div class="productView-product clearfix">
                            {%- for block in section.blocks -%}
                                {%- liquid
                                    assign spacing_top = block.settings.spacing_top
                                    assign spacing_bottom = block.settings.spacing_bottom
                                    assign spacing_top_mb = block.settings.spacing_top_mb | default: 0
                                    assign spacing_bottom_mb = block.settings.spacing_bottom_mb | default: 6
                                -%}
                                {%- case block.type -%}
                                    {%- when 'breadcrumb' -%}
                                        {%- if breadcrumb_layout == 'content' -%}
                                            <div class="productView-moreItem moreItem-breadcrumb npp-block npp-block--breadcrumb {% unless check_breadcrumb_full %}hidden-on-mobile{% endunless %}{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                                                style="--spacing-top: {{ breadcrumb_mg_top_desktop | append: 'px' }};
                                                --spacing-bottom: {{ breadcrumb_mg_bottom_desktop | append: 'px' }};
                                                --spacing-top-mb: {{ breadcrumb_mg_top_mobile | append: 'px' }};
                                                --spacing-bottom-mb: {{ breadcrumb_mg_bottom_mobile | append: 'px' }};
