                                                        assign has_tab_data = true
                                                    endif
                                                else
                                                    if is_static_content or is_static_kf or is_static_hb
                                                        assign has_tab_data = true
                                                    elsif product.metafields.custom.long_description != blank or product.description != blank
                                                        assign has_tab_data = true
                                                    elsif product.metafields.custom.features_text != blank or product.metafields.custom.benefits_text != blank
                                                        assign has_tab_data = true
                                                    endif
                                                endif
                                            endif
                                        -%}
                                        {%- if has_tab_data -%}
                                            {%- liquid
                                                assign desc_spacing_top = block.settings.spacing_top | default: 0
                                                assign desc_spacing_bottom = block.settings.spacing_bottom | default: 0
                                                assign desc_spacing_top_mb = block.settings.spacing_top_mb | default: 0
                                                assign desc_spacing_bottom_mb = block.settings.spacing_bottom_mb | default: 0
