<script>
(function() {
  function initMobileShare() {
    var shareBtn = document.querySelector('[data-mobile-share-btn]');
    if (!shareBtn || shareBtn.dataset.bound) return;
    shareBtn.dataset.bound = 'true';

    shareBtn.addEventListener('click', function(e) {
      e.preventDefault();
      e.stopPropagation();

      var shareUrl = window.location.href;
      var shareTitle = {{ product.title | json }} || document.title;

      if (navigator.share) {
        navigator.share({
          title: shareTitle,
          url: shareUrl
        }).catch(function(err) {});
      } else if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText(shareUrl).then(function() {
          showShareToast('Link copied to clipboard!');
        }).catch(function() {
          fallbackShare();
        });
      } else {
        fallbackShare();
      }

      function fallbackShare() {
        var desktopShare = document.querySelector('.productView-share .share-button__button');
        if (desktopShare) {
          desktopShare.click();
        } else {
          showShareToast('Link: ' + shareUrl);
        }
      }

      function showShareToast(msg) {
        var existing = document.getElementById('npp-mobile-share-toast');
        if (existing) existing.remove();

        var toast = document.createElement('div');
        toast.id = 'npp-mobile-share-toast';
        toast.textContent = msg;
        toast.style.cssText = 'position:fixed;bottom:80px;left:50%;transform:translateX(-50%);background:#1B3A6E;color:#ffffff;padding:10px 22px;border-radius:24px;font-size:13px;font-weight:600;z-index:999999;box-shadow:0 4px 16px rgba(0,0,0,0.25);transition:opacity 0.3s ease;pointer-events:none;letter-spacing:0.3px;';
        document.body.appendChild(toast);
        setTimeout(function() {
          toast.style.opacity = '0';
          setTimeout(function() { toast.remove(); }, 300);
        }, 2500);
      }
    });
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initMobileShare);
  } else {
    initMobileShare();
  }
})();
</script>

