                                                --breadcrumb-mb-bg: {% if breadcrumb_gradient_mb != blank and breadcrumb_gradient_mb != 'rgba(0,0,0,0)' %}{{ breadcrumb_gradient_mb }}{% elsif breadcrumb_bg_mb != blank and breadcrumb_bg_mb != 'rgba(0,0,0,0)' %}{{ breadcrumb_bg_mb }}{% else %}#fff{% endif %};
                                                "
                                                {{ block.shopify_attributes }}
                                            >
                                                {% render 'breadcrumb',
                                                    alignment: breadcrumb_alignment
                                                %}
                                            </div>
                                        {%- endif -%}
                                    {%- when 'vendor' -%}
                                        <div class="productView-moreItem{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                                            style="--spacing-top: {{ spacing_top | append: 'px' }};
                                            --spacing-bottom: {{ spacing_bottom | append: 'px' }}"
                                        >
                                            {% render 'product-vendor',
                                                block: block,
                                                product: product,
                                                fontsize_text: fontsize_text,
                                                color_title: color_title,
                                                text_transform: text_transform
                                            %}
                                        </div>
                                    {%- when 'badges' -%}
                                        <div class="productView-moreItem npp-block npp-block--badges{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger {% if share_layout == '3' %}animate--fade-in{% else %}animate--slide-in{% endif %}{% endif %}"
                                            style="--spacing-top: {{ spacing_top | default: 0 }}px;
                                            --spacing-bottom: {{ spacing_bottom | default: 8 }}px;
                                            --spacing-top-mb: {{ spacing_top_mb | default: 0 }}px;
                                            --spacing-bottom-mb: {{ spacing_bottom_mb | default: 6 }}px;"
                                            {{ block.shopify_attributes }}
                                        >
                                            {% render 'product-metafield-badges',
                                                product: product,
                                                alignment: block.settings.badges_alignment,
                                                alignment_mb: block.settings.badges_alignment_mb,
                                                position: 'above',
                                                block: block
                                            %}
                                        </div>
                                    {%- when 'title' -%}
                                        <div class="desktop_only_title productView-moreItem npp-block npp-block--title{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger {% if share_layout == '3' %}animate--fade-in{% else %}animate--slide-in{% endif %}{% endif %}"
                                            style="--spacing-top: {{ spacing_top | default: 0 }}px;
                                            --spacing-bottom: {{ spacing_bottom | default: 8 }}px;
                                            --spacing-top-mb: {{ spacing_top_mb | default: 0 }}px;
                                            --spacing-bottom-mb: {{ spacing_bottom_mb | default: 6 }}px;
                                            --title-align: {{ block.settings.title_alignment | default: 'left' }};
                                            --title-align-mb: {{ block.settings.title_alignment_mb | default: 'left' }};"
                                            {{ block.shopify_attributes }}
                                        >
                                            {% render 'product-title',
                                                block: block,
                                                product: product,
                                                check_show_share: check_show_share,
                                                share_layout: check_show_share
                                            %}
                                        </div>
                                    {%- when 'meta' -%}
                                        {%- liquid 
                                            assign show_sold_in = block.settings.show_sold_in
                                            assign sold_in_number = block.settings.sold_in_number
                                            assign sold_in_hours = block.settings.sold_in_hours
                                            assign color_text_sold_in = block.settings.color_text_sold_in
                                        -%}
                                        {%- if show_sold_in -%}
                                            <div class="productView-moreItem{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                                                style="--spacing-top: {{ spacing_top | append: 'px' }};
                                                --spacing-bottom: {{ spacing_bottom | append: 'px' }};
                                                --spacing-top-mb: {{ spacing_top_mb | append: 'px' }};
                                                --spacing-bottom-mb: {{ spacing_bottom_mb | append: 'px' }};
                                                --color-text-sold-in: {{ color_text_sold_in }}"
                                            >
                                                <div class="productView-meta{% if show_sold_in == false %} productView-meta-2{% endif %} clearfix">
                                                    {%- if show_sold_in -%}
                                                        {% render 'product-sold-in-last',
                                                            sold_in_number: sold_in_number,
                                                            sold_in_hours: sold_in_hours
                                                        %}
                                                    {%- endif -%}
                                                </div>
                                            </div>
                                        {%- endif -%}
                                        {%- when 'storeInfo' -%}
                                            {% render 'asIconeProducts', block: block %}
                                    {%- when 'productmetafield' -%}
                                        {%- liquid
                                            assign b_t1 = product.metafields.custom.benefit_text1 | strip_html | strip
                                            assign b_t2 = product.metafields.custom.benefit_text2 | strip_html | strip
                                            assign b_t3 = product.metafields.custom.benefit_text3 | strip_html | strip
                                            assign b_t4 = product.metafields.custom.benefit_text4 | strip_html | strip
                                            assign b_t5 = product.metafields.custom.benefit_text5 | strip_html | strip

                                            assign has_benefits_meta = false
                                            if product.metafields.custom.benefit_icon1 != blank or b_t1 != blank
                                                assign has_benefits_meta = true
                                            elsif product.metafields.custom.benefit_icon2 != blank or b_t2 != blank
                                                assign has_benefits_meta = true
                                            elsif product.metafields.custom.benefit_icon3 != blank or b_t3 != blank
                                                assign has_benefits_meta = true
                                            elsif product.metafields.custom.benefit_icon4 != blank or b_t4 != blank
                                                assign has_benefits_meta = true
                                            elsif product.metafields.custom.benefit_icon5 != blank or b_t5 != blank
                                                assign has_benefits_meta = true
                                            endif
                                        -%}
                                        {%- if has_benefits_meta -%}
                                            {%- liquid
                                                assign spacing_top = block.settings.spacing_top | default: 0
                                                assign spacing_bottom = block.settings.spacing_bottom | default: 16
                                                assign spacing_top_mb = block.settings.spacing_top_mb | default: 4
                                                assign spacing_bottom_mb = block.settings.spacing_bottom_mb | default: 10
                                                assign benefits_padding = block.settings.benefits_padding | default: 16
                                                assign benefits_padding_mb = block.settings.benefits_padding_mb | default: 12
                                                assign benefits_item_gap = block.settings.benefits_item_gap | default: 12
                                                assign benefits_item_gap_mb = block.settings.benefits_item_gap_mb | default: 8
                                                assign benefits_icon_text_gap = block.settings.benefits_icon_text_gap | default: 8
                                                assign benefits_icon_text_gap_mb = block.settings.benefits_icon_text_gap_mb | default: 6
                                                assign benefits_bg_color = block.settings.benefits_bg_color | default: '#EEF3EC'
                                                assign benefits_border_color = block.settings.benefits_border_color | default: 'transparent'
                                                assign benefits_border_radius = block.settings.benefits_border_radius | default: 16
                                                assign benefits_show_circle_bg = block.settings.benefits_show_circle_bg
                                                if benefits_show_circle_bg == false
                                                    assign benefits_circle_bg = 'transparent'
                                                else
                                                    assign benefits_circle_bg = block.settings.benefits_circle_bg | default: '#FFFFFF'
                                                endif
                                                assign benefits_circle_border = block.settings.benefits_circle_border | default: 'transparent'
                                                assign benefits_circle_border_width = block.settings.benefits_circle_border_width | default: 0
                                                assign benefits_circle_size = block.settings.benefits_circle_size | default: 56
                                                assign benefits_circle_size_mb = block.settings.benefits_circle_size_mb | default: 44
                                                assign benefits_circle_radius = block.settings.benefits_circle_radius | default: 50
                                                if benefits_circle_radius >= 50
                                                    assign benefits_circle_radius_css = '50%'
                                                else
                                                    assign benefits_circle_radius_css = benefits_circle_radius | append: 'px'
                                                endif
                                                assign benefits_circle_shadow = block.settings.benefits_circle_shadow
                                                if benefits_circle_shadow
                                                    assign benefits_circle_shadow_css = '0 2px 6px rgba(0, 0, 0, 0.08)'
                                                else
                                                    assign benefits_circle_shadow_css = 'none'
                                                endif
                                                assign benefits_icon_size = block.settings.benefits_icon_size | default: 38
                                                assign benefits_icon_size_mb = block.settings.benefits_icon_size_mb | default: 30
                                                assign benefits_icon_fit = block.settings.benefits_icon_fit | default: 'contain'
                                                assign benefits_text_color = block.settings.benefits_text_color | default: '#1B3B2B'
                                                assign benefits_font_size = block.settings.benefits_font_size | default: 13
                                                assign benefits_font_size_mb = block.settings.benefits_font_size_mb | default: 11
                                                assign benefits_font_weight = block.settings.benefits_font_weight | default: '600'
                                                assign benefits_text_align = block.settings.benefits_text_align | default: 'center'
                                                assign benefits_layout_desktop = block.settings.benefits_layout_desktop | default: 'row'
                                                assign benefits_layout_mobile = block.settings.benefits_layout_mobile | default: 'row'
                                                assign benefits_columns_mb = block.settings.benefits_columns_mb | default: 4
                                            -%}
                                            <div class="productView-moreItem npp-gallery-benefits npp-block npp-block--productmetafield{% if settings.banner_animation == 'effect_fade_up' %} scroll-trigger animate--slide-in{% endif %}"
                                                data-layout-desktop="{{ benefits_layout_desktop }}"
                                                data-layout-mobile="{{ benefits_layout_mobile }}"
                                                style="--spacing-top: {{ spacing_top }}px;
                                                --spacing-bottom: {{ spacing_bottom }}px;
                                                --spacing-top-mb: {{ spacing_top_mb }}px;
                                                --spacing-bottom-mb: {{ spacing_bottom_mb }}px;
                                                --benefits-bg-color: {{ benefits_bg_color }};
                                                --benefits-border-color: {{ benefits_border_color }};
                                                --benefits-border-radius: {{ benefits_border_radius }}px;
                                                --benefits-padding: {{ benefits_padding }}px;
                                                --benefits-padding-mb: {{ benefits_padding_mb }}px;
                                                --benefits-item-gap: {{ benefits_item_gap }}px;
                                                --benefits-item-gap-mb: {{ benefits_item_gap_mb }}px;
                                                --benefits-icon-text-gap: {{ benefits_icon_text_gap }}px;
                                                --benefits-icon-text-gap-mb: {{ benefits_icon_text_gap_mb }}px;
                                                --benefits-circle-bg: {{ benefits_circle_bg }};
                                                --benefits-circle-border: {{ benefits_circle_border }};
                                                --benefits-circle-border-width: {{ benefits_circle_border_width }}px;
                                                --benefits-circle-size: {{ benefits_circle_size }}px;
                                                --benefits-circle-size-mb: {{ benefits_circle_size_mb }}px;
                                                --benefits-circle-radius: {{ benefits_circle_radius_css }};
                                                --benefits-circle-shadow: {{ benefits_circle_shadow_css }};
                                                --benefits-icon-size: {{ benefits_icon_size }}px;
                                                --benefits-icon-size-mb: {{ benefits_icon_size_mb }}px;
                                                --benefits-icon-fit: {{ benefits_icon_fit }};
                                                --benefits-text-color: {{ benefits_text_color }};
                                                --benefits-font-size: {{ benefits_font_size }}px;
                                                --benefits-font-size-mb: {{ benefits_font_size_mb }}px;
                                                --benefits-font-weight: {{ benefits_font_weight }};
                                                --benefits-text-align: {{ benefits_text_align }};
                                                --benefits-columns-mb: {{ benefits_columns_mb }};"
                                                {{ block.shopify_attributes }}
                                            >
                                                {% render 'prdmetfieldsbenfits' %}
                                            </div>
                                        {%- endif -%}
                                    {%- when 'product_helps' -%}
                                        {% render 'product-helps-block', block: block, product: product %}
