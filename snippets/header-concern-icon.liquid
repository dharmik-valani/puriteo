{%- assign normalized_icon = icon | downcase | replace: '-', '_' | replace: ' ', '_' -%}
{%- if normalized_icon contains 'hair' -%}
  {%- assign normalized_icon = 'hair_fall' -%}
{%- elsif normalized_icon contains 'weight' -%}
  {%- assign normalized_icon = 'weight_loss' -%}
{%- elsif normalized_icon contains 'immun' -%}
  {%- assign normalized_icon = 'immunity' -%}
{%- elsif normalized_icon contains 'skin' or normalized_icon contains 'glow' -%}
  {%- assign normalized_icon = 'skin_glow' -%}
{%- elsif normalized_icon contains 'gut' or normalized_icon contains 'digest' -%}
  {%- assign normalized_icon = 'gut_health' -%}
{%- elsif normalized_icon contains 'sleep' or normalized_icon contains 'stress' -%}
  {%- assign normalized_icon = 'sleep_stress' -%}
{%- elsif normalized_icon contains 'gym' or normalized_icon contains 'fit' or normalized_icon contains 'workout' -%}
  {%- assign normalized_icon = 'gym_fitness' -%}
{%- elsif normalized_icon contains 'women' or normalized_icon contains 'pcos' or normalized_icon contains 'period' -%}
  {%- assign normalized_icon = 'womens_health' -%}
{%- endif -%}
{%- case normalized_icon -%}
  {%- when 'hair_fall' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M7 21c.5-5 2.5-9 5-13"/>
      <path d="M12 21c.5-7 2-12 5-17"/>
      <path d="M17 21c0-4 1-8 3-11"/>
    </svg>
  {%- when 'weight_loss' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <rect x="3" y="3" width="18" height="18" rx="4"/>
      <circle cx="12" cy="10" r="3"/>
      <path d="M12 9v2"/>
    </svg>
  {%- when 'immunity' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M12 3s7 3 7 9c0 6-7 9-7 9s-7-3-7-9c0-6 7-9 7-9z"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
  {%- when 'skin_glow' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="2.5"/>
      <path d="M12 3v3m0 12v3M3 12h3m12 0h3M5.6 5.6l2.1 2.1m8.6 8.6 2.1 2.1M5.6 18.4l2.1-2.1m8.6-8.6 2.1-2.1"/>
    </svg>
  {%- when 'gut_health' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M11 20A7 7 0 0 1 4 13C4 7 11 3 20 3c0 9-4 16-10 17z"/>
      <path d="M12 12c-2 2-4 5-5 8"/>
    </svg>
  {%- when 'sleep_stress' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
    </svg>
  {%- when 'gym_fitness' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M6 8v8M18 8v8M4 10v4M20 10v4M6 12h12"/>
    </svg>
  {%- when 'womens_health' -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="8" r="5"/>
      <path d="M12 13v8M9 17h6"/>
    </svg>
  {%- else -%}
    <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <circle cx="12" cy="12" r="9"/>
      <path d="m9 12 2 2 4-4"/>
    </svg>
{%- endcase -%}
