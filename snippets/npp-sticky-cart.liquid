<npp-sticky-cart
  id="npp-sticky-cart-{{ section.id }}"
  class="npp-sticky-cart{% if sticky_always_visible %} is-visible always-visible{% endif %}"
  style="
    --npp-sticky-ribbon-bg: {{ ribbon_bg }};
    --npp-sticky-ribbon-color: {{ ribbon_color }};
    --npp-sticky-btn-bg: {{ btn_bg }};
    --npp-sticky-btn-color: {{ btn_color }};
    --npp-sticky-price-color: {{ price_color }};
    --npp-sticky-compare-color: {{ compare_price_color }};
    --npp-sticky-savings-bg: {{ savings_bg }};
    --npp-sticky-savings-color: {{ savings_color }};
    --npp-sticky-trust-bg: {{ trust_bg }};
    --npp-sticky-trust-color: {{ trust_color }};
    --npp-sticky-star-color: {{ star_color }};
  "
  data-product-id="{{ product.id }}"
  data-section-id="{{ section.id }}"
  {% if sticky_always_visible %}data-always-visible="true"{% endif %}
>
  <div class="npp-sticky-cart__inner">
    <!-- Tier 1: Top Ribbon -->
    {% comment %} {%- if ribbon_text != blank -%}
      <div class="npp-sticky-cart__ribbon">
        <p class="npp-sticky-cart__ribbon-text" data-sticky-ribbon>{{ ribbon_text | escape }}</p>
      </div>
    {%- endif -%} {% endcomment %}

    <!-- Tier 2: Main Conversion Bar -->
    <div class="npp-sticky-cart__main">
      <div class="npp-sticky-cart__product">
        <div class="npp-sticky-cart__image-wrap">
          <img
            class="npp-sticky-cart__image"
            data-sticky-image
            src="{{ thumb_image | image_url: width: 140 }}"
            alt="{{ thumb_image.alt | default: product.title | escape }}"
            width="52"
            height="52"
            loading="lazy"
          >
        </div>
        <div class="npp-sticky-cart__pricing">
          <div class="npp-sticky-cart__prices">
            <span class="npp-sticky-cart__compare-wrap{% if compare_price <= price or compare_price == blank %} is-hidden{% endif %}" data-sticky-compare-wrap>
              <s class="npp-sticky-cart__compare" data-sticky-compare>{{ compare_price | money }}</s>
            </span>
            <span class="npp-sticky-cart__price" data-sticky-price>{{ price | money }}</span>
          </div>
          <div class="npp-sticky-cart__badge-wrap{% if savings <= 0 %} is-hidden{% endif %}" data-sticky-badge-wrap>
            <span class="npp-sticky-cart__badge" data-sticky-badge>Save&nbsp;<span data-sticky-savings>{{ savings | money }}</span>&nbsp;today!</span>
          </div>
        </div>
      </div>

      <div class="npp-sticky-cart__action">
        <form method="post" action="/cart/add" class="npp-sticky-cart__form" data-sticky-form>
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-sticky-variant-id>
          <input type="hidden" name="return_to" value="/checkout">
            

 
          {% comment %} <button
            type="button"
            onclick="onStickyBuyNowClick(this)"
id="npp-sticky-buy-now"
            class="npp-sticky-cart__btn"
            data-sticky-submit
            {% comment %} onclick="onBuyNowClick(this, '#{{ current_variant.id }}')" id="gokwik-buy-now" {% endcomment %}
            {% unless current_variant.available %}disabled{% endunless %}
          >
            <span data-sticky-btn-text>
              {%- if current_variant.available -%}
                {{ btn_text | escape }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button> {% endcomment %}

          <button
  type="button"
  class="npp-sticky-cart__btn"
  data-sticky-submit
  id="gokwik-buy-now-sticky"
  {% unless current_variant.available %}disabled{% endunless %}
>
  
   <span data-sticky-btn-text>
              {%- if current_variant.available -%}
                {{ btn_text | escape }}
              {%- else -%}
                {{ 'products.product.sold_out' | t }}
              {%- endif -%}
            </span>
          </button>
        </form>
      </div>
    </div>

    <!-- Tier 3: Bottom Trust Strip -->
    {%- if trust_customers != blank or trust_reviews != blank -%}
      <div class="npp-sticky-cart__trust">
        {%- if trust_customers != blank -%}
          <span class="npp-sticky-cart__trust-item">
            <span class="npp-sticky-cart__trust-star">★</span>
            <span class="npp-sticky-cart__trust-label">{{ trust_customers | escape }}</span>
          </span>
        {%- endif -%}
        {%- if trust_reviews != blank -%}
          <span class="npp-sticky-cart__trust-item">
            <span class="npp-sticky-cart__trust-star">★</span>
            <span class="npp-sticky-cart__trust-label">{{ trust_reviews | escape }}</span>
          </span>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {% comment %} <script type="application/json" data-sticky-variants-json>
    {{ product.variants | json }}
  </script> {% endcomment %}
</npp-sticky-cart>

<script>
  if (!customElements.get('npp-sticky-cart')) {
    class NppStickyCart extends HTMLElement {
      connectedCallback() {
        this.variants = [];
        try {
          const jsonEl = this.querySelector('[data-sticky-variants-json]');
          if (jsonEl) this.variants = JSON.parse(jsonEl.textContent || '[]');
        } catch (e) {
          console.warn('[NppStickyCart] Error parsing variants JSON', e);
        }

        this.variantInput = this.querySelector('[data-sticky-variant-id]');
        this.priceEl = this.querySelector('[data-sticky-price]');
        this.compareWrap = this.querySelector('[data-sticky-compare-wrap]');
        this.compareEl = this.querySelector('[data-sticky-compare]');
        this.badgeWrap = this.querySelector('[data-sticky-badge-wrap]');
        this.savingsEl = this.querySelector('[data-sticky-savings]');
        this.imageEl = this.querySelector('[data-sticky-image]');
        this.submitBtn = this.querySelector('[data-sticky-submit]');
        this.btnTextEl = this.querySelector('[data-sticky-btn-text]');

        this.initScroll();
        this.initVariantListener();
        this.initFormSubmit();
      }

      initScroll() {
        if (this.dataset.alwaysVisible === 'true' || this.classList.contains('always-visible')) {
          this.classList.add('is-visible');
          return;
        }

        const target = document.querySelector('.npp-block--buy_buttons') || document.querySelector('.productView-action') || document.querySelector('.product-form__buttons') || document.querySelector('.productView-product');
        if (!target) {
          this.classList.add('is-visible');
          return;
        }

        const onScroll = () => {
          const rect = target.getBoundingClientRect();
          // Show once customer scrolls past the main buy buttons
          if (rect.bottom < 0) {
            this.classList.add('is-visible');
          } else {
            this.classList.remove('is-visible');
          }
        };

        window.addEventListener('scroll', onScroll, { passive: true });
        onScroll();
      }

      initVariantListener() {
        const updateFromVariantId = (variantId) => {
          if (!variantId || !this.variants.length) return;
          const matched = this.variants.find(v => String(v.id) === String(variantId));
          if (matched) this.syncVariant(matched);
        };

        // Listen for standard form changes and pack card clicks
        document.addEventListener('change', (e) => {
          if (e.target.name === 'id') {
            updateFromVariantId(e.target.value);
          } else if (e.target.matches('[data-variant-id]')) {
            updateFromVariantId(e.target.getAttribute('data-variant-id'));
          }
        });

        document.addEventListener('click', (e) => {
          const card = e.target.closest('.npp-pack-card, [data-variant-id]');
          if (card) {
            const vid = card.getAttribute('data-variant-id');
            if (vid) updateFromVariantId(vid);
          }
        });
      }

      syncVariant(variant) {
        if (this.variantInput) this.variantInput.value = variant.id;

        const price = variant.price;
        const comparePrice = variant.compare_at_price;

        if (this.priceEl) this.priceEl.innerHTML = this.formatMoney(price);

        if (comparePrice && comparePrice > price) {
          if (this.compareEl) this.compareEl.innerHTML = this.formatMoney(comparePrice);
          if (this.compareWrap) this.compareWrap.classList.remove('is-hidden');
          const saveVal = comparePrice - price;
          if (this.savingsEl) this.savingsEl.innerHTML = this.formatMoney(saveVal);
          if (this.badgeWrap) this.badgeWrap.classList.remove('is-hidden');
        } else {
          if (this.compareWrap) this.compareWrap.classList.add('is-hidden');
          if (this.badgeWrap) this.badgeWrap.classList.add('is-hidden');
        }

        if (variant.featured_image && variant.featured_image.src && this.imageEl) {
          this.imageEl.src = variant.featured_image.src;
        }

        if (this.submitBtn) {
          if (variant.available) {
            this.submitBtn.disabled = false;
            if (this.btnTextEl) this.btnTextEl.textContent = 'BUY NOW';
          } else {
            this.submitBtn.disabled = true;
            if (this.btnTextEl) this.btnTextEl.textContent = 'Sold Out';
          }
        }
      }

      formatMoney(cents) {
        if (!cents && cents !== 0) return '';
        const amount = Math.round(Number(cents) / 100);
        return '₹' + amount.toLocaleString('en-IN');
      }

      {% comment %} initFormSubmit() {
  const form = this.querySelector('[data-sticky-form]');
  const submitBtn = this.querySelector('[data-sticky-submit]');
  if (!form || !submitBtn) return;

  const triggerBuyNow = (event) => {
    event.preventDefault();
    event.stopPropagation();

    if (submitBtn.disabled) return;

    const variantID = this.variantInput?.value;
    const variant = this.variants.find(
      (item) => String(item.id) === String(variantID)
    );

    if (!variantID || (variant && !variant.available)) return;

    // Find the main GoKwik button, never the sticky button.
    const mainBtn = Array.from(
      document.querySelectorAll('[id="gokwik-buy-now-sticky"]')
    ).find((button) => !this.contains(button));

    if (
      !mainBtn ||
      mainBtn.disabled ||
      typeof window.onBuyNowClick !== 'function'
    ) {
      console.warn('[NppStickyCart] Main GoKwik button is not ready.');
      return;
    }

    // Uses the sticky quantity if present; otherwise defaults to 1.
    const quantityInput = form.querySelector('[name="quantity"]');
    const quantity = Math.max(
      1,
      parseInt(quantityInput?.value || '1', 10) || 1
    );

    window.onBuyNowClick(mainBtn, false, [
      { id: variantID, quantity: quantity }
    ]);
  };

  submitBtn.addEventListener('click', triggerBuyNow);
  form.addEventListener('submit', triggerBuyNow);
} {% endcomment %}


initFormSubmit() {
  const form = this.querySelector('[data-sticky-form]');
  const submitBtn = this.querySelector('[data-sticky-submit]');
  if (!form || !submitBtn) return;

  const triggerBuyNow = (event) => {
    event.preventDefault();
    event.stopPropagation();

    if (submitBtn.disabled) return;

    // Read the variant that syncVariant() keeps updated.
    const variantID = this.variantInput?.value;
    if (!variantID) {
      console.warn('[NppStickyCart] No selected variant.');
      return;
    }

    const variant = this.variants.find(
      (item) => String(item.id) === String(variantID)
    );

    if (variant && !variant.available) return;

    // No quantity field in the supplied sticky form: defaults to 1.
    const quantityInput = form.querySelector('[name="quantity"]');
    const quantity = Math.max(
      1,
      parseInt(quantityInput?.value || '1', 10) || 1
    );

    if (typeof window.onBuyNowClick !== 'function') {
      console.warn('[NppStickyCart] GoKwik is not ready yet.');
      return;
    }

    // Same argument structure used in product-button.liquid.
    window.onBuyNowClick(submitBtn, false, [
      { id: variantID, quantity: quantity }
    ]);
    
  };

  submitBtn.addEventListener('click', triggerBuyNow);
  form.addEventListener('submit', triggerBuyNow);
} 

      {% comment %} initFormSubmit() {
        const form = this.querySelector('[data-sticky-form]');
        const submitBtn = this.querySelector('[data-sticky-submit]');
        if (!form) return;

        const triggerPageBuyNow = (e) => {
          const currentVariantId = this.variantInput ? this.variantInput.value : null;

          // 1. Sync current variant into the main product page form(s)
          if (currentVariantId) {
            const allIdInputs = document.querySelectorAll(
              '.productView-form input[name="id"], .productView-action input[name="id"], form[action*="/cart/add"] input[name="id"]'
            );
            allIdInputs.forEach((inp) => {
              if (inp !== this.variantInput && inp.value !== currentVariantId) {
                inp.value = currentVariantId;
                inp.dispatchEvent(new Event('change', { bubbles: true }));
              }
            });
          }

          // 2. Find the product page Buy Now button (GoKwik / Dynamic checkout)
          const pageBuyNowBtn = document.getElementById('gokwik-buy-now')
            || document.querySelector('.productView-payment #gokwik-buy-now')
            || document.querySelector('.productView-payment button:not([data-sticky-submit])')
            || document.querySelector('.shopify-payment-button__button')
            || document.querySelector('[data-shopify="payment-button"]')
            || document.querySelector('.productView-payment [data-gokwik-checkout], .gokwik-checkout button, .gokwik-checkout');

          if (pageBuyNowBtn) {
            if (e) {
              e.preventDefault();
              e.stopPropagation();
            }

            pageBuyNowBtn.removeAttribute('disabled');
            pageBuyNowBtn.classList.remove('disabled');

            try {
              if (typeof window.onBuyNowClick === 'function' && (pageBuyNowBtn.id === 'gokwik-buy-now' || (pageBuyNowBtn.getAttribute('onclick') && pageBuyNowBtn.getAttribute('onclick').includes('onBuyNowClick')))) {
                window.onBuyNowClick(pageBuyNowBtn);
              } else {
                pageBuyNowBtn.click();
              }
            } catch (err) {
              console.warn('[NppStickyCart] Error triggering page Buy Now button, falling back to click()', err);
              pageBuyNowBtn.click();
            }
            return false;
          }

          // 3. If onBuyNowClick is globally available
          if (typeof window.onBuyNowClick === 'function') {
            if (e) {
              e.preventDefault();
              e.stopPropagation();
            }
            window.onBuyNowClick(submitBtn || form);
            return false;
          }
        };

        if (submitBtn) {
          submitBtn.addEventListener('click', (e) => {
            triggerPageBuyNow(e);
          });
        }

        form.addEventListener('submit', (e) => {
          triggerPageBuyNow(e);
        });
      } {% endcomment %}
    }

    customElements.define('npp-sticky-cart', NppStickyCart);
  }
</script>
