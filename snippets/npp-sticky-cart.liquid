{% doc %}
  Renders the 3-tier conversion sticky bar for the new product page template.
  @param {product} product
  @param {variant} [current_variant]
  @param {section} section
{% enddoc %}

{%- liquid
  assign current_variant = current_variant | default: product.selected_or_first_available_variant
  assign compare_price = current_variant.compare_at_price
  assign price = current_variant.price

  assign savings = 0
  if compare_price > price
    assign savings = compare_price | minus: price
  endif

  assign ribbon_text = section.settings.sticky_ribbon_text | default: 'Control cravings & reduce overeating at just ₹41/day'
  if product.metafields.custom.sticky_bar_banner != blank
    assign ribbon_text = product.metafields.custom.sticky_bar_banner
  elsif product.metafields.custom.per_day_cost != blank
    assign ribbon_text = product.metafields.custom.per_day_cost
  endif

  assign price_block = section.blocks | where: "type", "price" | first
  assign price_color = section.settings.sticky_price_color | default: price_block.settings.color_price | default: '#1b3a6e'
  assign compare_price_color = section.settings.sticky_compare_color | default: price_block.settings.compare_price_color | default: '#6b7280'

  assign ribbon_bg = section.settings.sticky_ribbon_bg | default: '#5E7CE2'
  assign ribbon_color = section.settings.sticky_ribbon_color | default: '#FFFFFF'
  assign btn_text = section.settings.sticky_btn_text | default: 'BUY NOW'
  assign btn_bg = section.settings.sticky_btn_bg
  if btn_bg == blank or btn_bg == '#004141'
    assign btn_bg = settings.btnBClr | default: '#3f3586'
  endif
  assign btn_color = section.settings.sticky_btn_color | default: '#FFFFFF'
  assign savings_bg = section.settings.sticky_savings_bg | default: '#EAF8F0'
  assign savings_color = section.settings.sticky_savings_color | default: '#15803D'
  assign trust_customers = section.settings.sticky_trust_customers | default: '50 Lakh+ Happy Customers'
  assign trust_reviews = section.settings.sticky_trust_reviews | default: '261+ verified reviews'
  assign trust_bg = section.settings.sticky_trust_bg | default: '#F0FAF0'
  assign trust_color = section.settings.sticky_trust_color | default: '#004141'
  assign star_color = section.settings.sticky_star_color | default: '#F59E0B'

  assign thumb_image = current_variant.image
  if thumb_image == blank
    assign thumb_image = product.featured_image
  endif

  assign sticky_always_visible = true
-%}

<style>
.npp-sticky-cart {
  position: fixed;
  bottom: 0;
  left: 0;
  width: 100%;
  z-index: 98;
  pointer-events: none;
  transform: translateY(115%);
  opacity: 0;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), opacity 0.25s ease;
  box-sizing: border-box;
}

.npp-sticky-cart.is-visible,
.npp-sticky-cart.always-visible {
  transform: translateY(0) !important;
  opacity: 1 !important;
  pointer-events: auto !important;
}

/* Ensure sticky add to cart is visible by default when on new-product-page */
.product-new-products .productView-stickyCart.always-visible,
.product-new-products .productView-stickyCart.always-on-desktop {
  top: auto !important;
  bottom: 0 !important;
  opacity: 1 !important;
  visibility: visible !important;
  pointer-events: auto !important;
}

@media (max-width: 767px) {
  .product-new-products .productView-stickyCart {
    top: auto !important;
    bottom: 0 !important;
    opacity: 1 !important;
    visibility: visible !important;
    pointer-events: auto !important;
  }
}

/* Hide sticky cart when any Reel / Video Modal / Popup is open */
body:has([class*="ins-modal"]:not([style*="display: none"]), [class*="ins-video-modal"]:not([style*="display: none"]), [class*="reel-modal"]:not([style*="display: none"]), [class*="shoppable-video"]:not([style*="display: none"]), [class*="popup"]:has(video)) .npp-sticky-cart,
body:has([class*="ins-modal"]:not([style*="display: none"]), [class*="ins-video-modal"]:not([style*="display: none"]), [class*="reel-modal"]:not([style*="display: none"]), [class*="shoppable-video"]:not([style*="display: none"]), [class*="popup"]:has(video)) .productView-stickyCart,
body.ins-modal-open .npp-sticky-cart,
body.modal-open .npp-sticky-cart,
body.has-reel-open .npp-sticky-cart,
body.ins-modal-open .productView-stickyCart,
body.modal-open .productView-stickyCart,
body.has-reel-open .productView-stickyCart,
.npp-sticky-cart.is-hidden-by-modal,
.product-new-products .productView-stickyCart.is-hidden-by-modal {
  display: none !important;
  opacity: 0 !important;
  visibility: hidden !important;
  pointer-events: none !important;
  transform: translateY(115%) !important;
  z-index: -1 !important;
}

/* When mobile hamburger menu or drawer is open, keep sticky cart in the background behind drawer & backdrop */
body.menu_open .npp-sticky-cart,
body.menu-open .npp-sticky-cart,
body.overflow-hidden-mobile .npp-sticky-cart,
body:has(.header-compact-drawer.is-open) .npp-sticky-cart,
body:has(#navigation-mobile.halo-sidebar.is-open) .npp-sticky-cart,
body.menu_open .productView-stickyCart,
body.menu-open .productView-stickyCart,
body.overflow-hidden-mobile .productView-stickyCart,
body:has(.header-compact-drawer.is-open) .productView-stickyCart,
body:has(#navigation-mobile.halo-sidebar.is-open) .productView-stickyCart {
  z-index: 10 !important;
  pointer-events: none !important;
}
.npp-sticky-cart__inner {
  background: #ffffff;
  overflow: hidden;
  box-shadow: 0 4px 20px rgba(0, 0, 0, 0.12);
  margin: 0 auto;
}
/* Tier 1: Top Ribbon */
.npp-sticky-cart__ribbon {
  background: var(--npp-sticky-ribbon-bg, #5E7CE2);
  color: var(--npp-sticky-ribbon-color, #ffffff);
  padding: 4px;
  text-align: center;
  box-sizing: border-box;
}

.npp-sticky-cart__ribbon-text {
  margin: 0;
  font-family: inherit;
  font-size: 13px;
  line-height: 15.6px;
  font-weight: 500;
  letter-spacing: 0.044px;
  color: inherit;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 4px;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* Tier 2: Main Bar */
.npp-sticky-cart__main {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 8px;
  gap: 12px;
  background: #ffffff;
  box-sizing: border-box;
}

.npp-sticky-cart__product {
  display: flex;
  align-items: center;
  gap: 10px;
  min-width: 0;
  flex: 0 1 auto;
}

.npp-sticky-cart__image-wrap {
  flex-shrink: 0;
  width: 44px;
  height: 44px;
  border-radius: 8px;
  overflow: hidden;
  background: #ffffff;
  border: 1px solid rgba(0, 0, 0, 0.08);
