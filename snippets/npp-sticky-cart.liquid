}

.npp-sticky-cart__form {
  margin: 0;
  padding: 0;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  width: 100%;
}

.npp-sticky-cart__btn {
  background: var(--npp-sticky-btn-bg, #004141);
  color: var(--npp-sticky-btn-color, #ffffff);
  border: 0;
  outline: none;
  border-radius: 8px;
  padding: 8px 28px;
  min-height: 40px;
  max-height: 40px;
  height: 40px;
  min-width: 111px;
  flex-grow: 1;
  flex-shrink: 0;
  font-family: inherit;
  font-size: 14px;
  line-height: 15.6px;
  font-weight: 700;
  letter-spacing: 0.056px;
  text-transform: uppercase;
  cursor: pointer;
  transition: opacity 0.2s ease, transform 0.15s ease, background-color 0.2s ease;
  white-space: nowrap;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  box-shadow: none;
  box-sizing: border-box;
}

.npp-sticky-cart__btn:hover {
  opacity: 0.94;
  transform: translateY(-1px);
}

.npp-sticky-cart__btn:active {
  transform: translateY(0);
}

.npp-sticky-cart__btn:disabled {
  background: #cccccc !important;
  color: #666666 !important;
  cursor: not-allowed;
  transform: none;
  box-shadow: none;
}

/* Tier 3: Bottom Trust Strip */
.npp-sticky-cart__trust {
