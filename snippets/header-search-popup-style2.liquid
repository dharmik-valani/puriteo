{%- comment -%}
  Search Popup Style 2 (Oziva Modern Modal Popup)
  Matches reference design with floating round close button, search input with cart icon,
  "Discover solutions for better health" quick pills, and "Explore our Best Sellers" product grid.
{%- endcomment -%}

<style>
  @media screen and (max-width: 768px) {
    #HeaderSearch2Modal-{{ section.id }}.header-search2-modal {
      padding: 24px 8px 16px !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .header-search2-modal__card {
      padding: 16px 10px 20px !important;
      border-radius: 16px !important;
    }

    /* 2-Column Product Grid Matching Homepage */
    #HeaderSearch2Modal-{{ section.id }} .header-search2-modal__products-grid,
    #HeaderSearch2Modal-{{ section.id }} .header-search2-modal__results .products-grid,
    #HeaderSearch2Modal-{{ section.id }} #predictive-search-results-list .products-grid {
      display: grid !important;
      grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
      gap: 10px !important;
      width: 100% !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .header-search2-modal__products-grid .product,
    #HeaderSearch2Modal-{{ section.id }} .header-search2-modal__results .products-grid .product {
      display: flex !important;
      width: 100% !important;
      max-width: 100% !important;
      min-width: 0 !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    /* Card Outer Shape - Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .product-item,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card {
      width: 100% !important;
      height: 100% !important;
      display: flex !important;
      flex-direction: column !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card {
      display: flex !important;
      flex-direction: column !important;
      height: 100% !important;
      width: 100% !important;
      background: #ffffff !important;
      border: 1px solid #e6eef8 !important;
      border-radius: 18px !important;
      overflow: hidden !important;
      box-shadow: none !important;
      box-sizing: border-box !important;
    }

    /* Media Box - Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .card-media,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card-media {
      margin: 8px !important;
      width: calc(100% - 16px) !important;
      border-radius: 12px !important;
      padding-bottom: 100% !important;
      background: transparent !important;
      position: relative !important;
      overflow: hidden !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-media img,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card-media img {
      position: absolute !important;
      top: 0 !important;
      left: 0 !important;
      width: 100% !important;
      height: 100% !important;
      object-fit: cover !important;
      padding: 0 !important;
      margin: 0 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-media .halo-productBadges,
    #HeaderSearch2Modal-{{ section.id }} .card-media .card__badge {
      top: 8px !important;
      left: 8px !important;
      position: absolute !important;
      z-index: 3 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-media .halo-productBadges .badge,
    #HeaderSearch2Modal-{{ section.id }} .card-media .badge.sale-badge {
      font-size: 11px !important;
      font-weight: 700 !important;
      padding: 3px 8px !important;
      border-radius: 50px !important;
    }

    /* Content Area - Matches Homepage Padding & Bottom Gap */
    #HeaderSearch2Modal-{{ section.id }} .card-information,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card-information {
      padding: 8px 12px 16px 12px !important;
      display: flex !important;
      flex-direction: column !important;
      flex: 1 1 auto !important;
      justify-content: space-between !important;
      box-sizing: border-box !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-information__wrapper,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card-information__wrapper {
      display: flex !important;
      flex-direction: column !important;
      gap: 5px !important;
      margin-bottom: 14px !important;
    }

    /* Judgeme Rating */
    #HeaderSearch2Modal-{{ section.id }} .as-card-rating {
      margin: 0 0 2px 0 !important;
      line-height: 1 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .as-card-rating .jdgm-prev-badge {
      display: inline-flex !important;
      align-items: center !important;
      gap: 4px !important;
      line-height: 1 !important;
      flex-wrap: nowrap !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .as-card-rating .jdgm-star {
      font-size: 11px !important;
      color: #1b3a6e !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .as-card-rating .jdgm-prev-badge__text {
      font-size: 11px !important;
      color: #1b3a6e !important;
      white-space: nowrap !important;
    }

    /* Title Sizing - Exactly Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .card-title,
    #HeaderSearch2Modal-{{ section.id }} a.card-title,
    #HeaderSearch2Modal-{{ section.id }} .card-title .text {
      font-size: 15px !important;
      font-weight: 700 !important;
      color: #1b3a6e !important;
      line-height: 1.25 !important;
      text-decoration: none !important;
      display: -webkit-box !important;
      -webkit-line-clamp: 2 !important;
      -webkit-box-orient: vertical !important;
      overflow: hidden !important;
      min-height: 38px !important;
      margin: 0 !important;
    }

    /* Summary - Exactly Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .as-card-summary {
      font-size: 11.5px !important;
      color: #6b84ad !important;
      font-weight: 400 !important;
      line-height: 1.3 !important;
      white-space: nowrap !important;
      overflow: hidden !important;
      text-overflow: ellipsis !important;
      margin: 1px 0 0 0 !important;
    }

    /* Price Sizing - Exactly Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .card-price {
      margin: 4px 0 0 0 !important;
      padding: 0 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-price .price,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price dl {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      margin: 0 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-price .price--on-sale .price__sale {
      display: flex !important;
      flex-direction: row !important;
      flex-wrap: nowrap !important;
      align-items: center !important;
      gap: 5px !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-price .price-item,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price-item--sale,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price-item .money,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price-item--sale .money {
      font-size: 16px !important;
      font-weight: 700 !important;
      color: #1b3a6e !important;
      line-height: 1.2 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-price .price__compare,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price__compare .price-item,
    #HeaderSearch2Modal-{{ section.id }} .card-price s.price-item,
    #HeaderSearch2Modal-{{ section.id }} .card-price .price-item--regular .money {
      font-size: 13px !important;
      font-weight: 400 !important;
      color: #9aa8c2 !important;
      text-decoration: line-through !important;
      margin-left: 5px !important;
    }

    /* Button Sizing & Styling - Exactly Matches Homepage */
    #HeaderSearch2Modal-{{ section.id }} .card-action,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .card-action,
    #HeaderSearch2Modal-{{ section.id }} .product-item--as-card .as-card-action {
      margin-top: auto !important;
      margin-bottom: 0 !important;
      min-height: 44px !important;
      width: 100% !important;
      display: block !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .card-action > form,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action > form {
      min-height: 44px !important;
      width: 100% !important;
      margin: 0 !important;
    }

    #HeaderSearch2Modal-{{ section.id }} .as-card-action .button,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action .button.button-ATC,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action a.button,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action button.button,
    #HeaderSearch2Modal-{{ section.id }} .as-card-action .button-ATC {
      min-height: 44px !important;
      height: 44px !important;
      padding: 10px 14px !important;
      font-size: 12.5px !important;
      font-weight: 700 !important;
      letter-spacing: 0.04em !important;
      border-radius: 999px !important;
      background: #1B3A6E !important;
      border: 1px solid #1B3A6E !important;
      color: #FFFFFF !important;
      text-transform: uppercase !important;
      line-height: 1.2 !important;
      display: inline-flex !important;
      align-items: center !important;
      justify-content: center !important;
      width: 100% !important;
      box-shadow: none !important;
      margin: 0 !important;
      cursor: pointer !important;
    }
  }
</style>

<div
  class="header-search2-modal"
  id="HeaderSearch2Modal-{{ section.id }}"
  role="dialog"
  aria-modal="true"
  aria-label="{{ 'general.search.search' | t }}"
  aria-hidden="true"
>
  <!-- Backdrop -->
  <div class="header-search2-modal__backdrop" id="HeaderSearch2Backdrop-{{ section.id }}"></div>

  <!-- Modal Container -->
  <div class="header-search2-modal__container">

    <!-- Floating Circular White Close Button (Matches Reference) -->
    <button
      type="button"
      class="header-search2-modal__close"
      id="HeaderSearch2Close-{{ section.id }}"
      aria-label="{{ 'general.common.close' | t }}"
    >
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="#111111" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <!-- Card Content -->
    <div class="header-search2-modal__card custom-scrollbar">

      <!-- Search Input Box Form with Shopify Predictive Search -->
      {%- if settings.show_quick_search -%}
        <predictive-search class="header-search2-modal__predictive search-modal__form" data-loading-text="{{ 'accessibility.loading' | t }}" data-product-to-show="{{ settings.quick_search_to_show }}">
      {%- endif -%}

      <form action="{{ routes.search_url }}" method="get" role="search" class="search header-search2-modal__form">
        <div class="header-search2-modal__input-wrapper">
          <span class="header-search2-modal__search-icon" aria-hidden="true">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="fill: none !important;">
              <circle cx="11" cy="11" r="7.5" fill="none" style="fill: none !important; stroke: currentColor !important;"></circle>
              <line x1="21" y1="21" x2="16.5" y2="16.5" style="stroke: currentColor !important;"></line>
            </svg>
          </span>

          <input
            class="header-search2-modal__input search__input"
            id="Search2-In-Modal-{{ section.id }}"
            type="search"
            name="q"
            value="{{ search.terms | escape }}"
            placeholder="{{ section.settings.search_placeholder_desktop | default: 'Search for health products, concerns...' }}"
            autocomplete="off"
            {%- if settings.show_quick_search -%}
              role="combobox"
              aria-expanded="false"
              aria-owns="predictive-search-results-list"
              aria-controls="predictive-search-results-list"
              aria-haspopup="listbox"
              aria-autocomplete="list"
              autocorrect="off"
              autocapitalize="off"
              spellcheck="false"
            {%- endif -%}
          >
          <input type="hidden" name="options[prefix]" value="last">
          <input type="hidden" name="type" value="product">

          <!-- Clear Button (matches Reference Image 2) -->
          <button
            type="button"
            class="header-search2-modal__clear-btn"
            id="HeaderSearch2Clear-{{ section.id }}"
            aria-label="{{ 'general.common.close' | t }}"
            style="display: none;"
          >
            <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <line x1="18" y1="6" x2="6" y2="18"></line>
              <line x1="6" y1="6" x2="18" y2="18"></line>
            </svg>
          </button>

          <!-- Right Icon: Cart Icon from Reference Image -->
          <a href="{{ routes.cart_url }}" class="header-search2-modal__cart-icon" aria-label="{{ 'sections.header.cart_count' | t: count: cart.item_count }}">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"></path>
              <circle cx="9" cy="21" r="1.5"></circle>
              <circle cx="20" cy="21" r="1.5"></circle>
            </svg>
          </a>
        </div>

        <!-- Predictive Search Results Container -->
        {%- if settings.show_quick_search -%}
          <div class="header-search2-modal__results">
            {%- render 'predictive-search-results' -%}
          </div>
        {%- endif -%}
      </form>

      {%- if settings.show_quick_search -%}
        </predictive-search>
      {%- endif -%}

      <!-- Pre-search Content (Solutions & Best Sellers) -->
      <div class="header-search2-modal__default-content" id="HeaderSearch2DefaultContent-{{ section.id }}">

        <!-- 1. TRENDING NOW Section (Exact Style 1 Layout & Pills) -->
        {%- assign show_tags = section.settings.style2_show_tags -%}
        {%- if show_tags == nil -%}{%- assign show_tags = settings.style2_show_tags -%}{%- endif -%}
        {%- if show_tags == nil -%}{%- assign show_tags = true -%}{%- endif -%}

        {%- if show_tags -%}
          <div class="header-search2-modal__section header-search2-modal__section--trending">
            <h3 class="header-search2-modal__section-heading">
              <span class="text">{{ section.settings.style2_tags_heading | default: settings.style2_tags_heading | default: settings.search_trending_title | default: 'TRENDING NOW' | upcase }}</span>
            </h3>

            <div class="header-search2-modal__tags-grid">
              {%- assign custom_tags = section.settings.style2_tags_list -%}
              {%- if custom_tags == blank -%}{%- assign custom_tags = settings.style2_tags_list -%}{%- endif -%}
              {%- if custom_tags != blank -%}
                {%- assign tags_array = custom_tags | split: "," -%}
              {%- else -%}
                {%- capture trending_items_str -%}
                  {%- for i in (1..15) -%}
                    {%- capture cap_seach_trending_item -%}seach_trending_item_{{ i }}{%- endcapture -%}
                    {%- assign item_val = settings[cap_seach_trending_item] -%}
                    {%- if item_val != blank -%}
                      {{ item_val }}|
                    {%- endif -%}
                  {%- endfor -%}
                {%- endcapture -%}
                {%- if trending_items_str != blank -%}
                  {%- assign tags_array = trending_items_str | split: "|" -%}
                {%- else -%}
                  {%- assign tags_array = "Sleep,Immunity,Energy,Detox,Weight" | split: "," -%}
                {%- endif -%}
              {%- endif -%}

              {%- for raw_tag in tags_array -%}
                {%- assign tag = raw_tag | strip -%}
                {%- if tag == blank %}{% continue %}{% endif -%}
                <button
                  type="button"
                  class="header-search2-modal__tag-btn"
                  data-search-term="{{ tag | escape }}"
                >
                  <span class="header-search2-modal__tag-icon">
                    <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" style="fill: none !important;">
                      <circle cx="11" cy="11" r="7.5" fill="none" style="fill: none !important; stroke: currentColor !important;"></circle>
                      <line x1="21" y1="21" x2="16.5" y2="16.5" style="stroke: currentColor !important;"></line>
                    </svg>
                  </span>
                  <span class="header-search2-modal__tag-label">{{ tag }}</span>
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <!-- Horizontal Divider (Exact Style 1) -->
        <div class="header-search2-modal__divider"></div>

        <!-- 2. BEST SELLER Section (Exact Style 1 Heading + View All Results + product-card-09) -->
        {%- assign show_bestsellers = section.settings.style2_show_bestsellers -%}
        {%- if show_bestsellers == nil -%}{%- assign show_bestsellers = settings.style2_show_bestsellers -%}{%- endif -%}
        {%- if show_bestsellers == nil -%}{%- assign show_bestsellers = true -%}{%- endif -%}

        {%- if show_bestsellers -%}
          <div class="header-search2-modal__section header-search2-modal__section--bestsellers">
            <div class="header-search2-modal__bestsellers-header">
              <h3 class="header-search2-modal__section-heading">
                <span class="text">{{ section.settings.style2_bestsellers_heading | default: settings.style2_bestsellers_heading | default: settings.search_product_title | default: 'BEST SELLER' | upcase }}</span>
              </h3>
              <a class="header-search2-modal__view-all" href="{{ routes.search_url }}">
                <span>View all results</span>
                <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <line x1="5" y1="12" x2="19" y2="12"></line>
                  <polyline points="12 5 19 12 12 19"></polyline>
                </svg>
              </a>
            </div>

            {%- assign bs_collection_handle = section.settings.style2_bestseller_collection | default: settings.style2_bestseller_collection | default: settings.search_product_collection | default: 'best-sellers' -%}
            {%- assign bs_collection = collections[bs_collection_handle] -%}
            {%- if bs_collection == blank or bs_collection.products_count == 0 -%}
              {%- assign bs_collection = collections['all'] -%}
            {%- endif -%}
            {%- assign bs_limit = section.settings.style2_bestseller_limit | default: settings.style2_bestseller_limit | default: settings.search_product_to_show | default: 3 -%}

            <div class="header-search2-modal__products-grid products-grid column-3">
              {%- if bs_collection.products.size > 0 -%}
                {%- for product in bs_collection.products limit: bs_limit -%}
                  <div class="product">
                    {% render 'product-grid-layout',
                      product_card_product: product,
                      media_size: 'square',
                      portrait_aspect_ratio: '125',
                      serial: forloop.index,
                      sectionId: section.id,
                      loading: true
                    %}
                  </div>
                {%- endfor -%}
              {%- endif -%}
            </div>
          </div>
        {%- endif -%}

      </div>

    </div>
  </div>
</div>
